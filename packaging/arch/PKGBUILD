# Maintainer: Mikai local QA build <noreply@localhost>
# Built from an exported source tarball by packaging/linux/arch-package.sh, which
# substitutes pkgver, _revision and sha256sums. A manual `makepkg` needs them replaced.
pkgname=mikai
pkgver=@VERSION@
pkgrel=1
pkgdesc='Mikai Ja Nai desktop client for the Mikai anime catalogue, with a libmpv player'
arch=('x86_64')
url=''
license=('Unlicense')
depends=('qt6-base' 'qt6-declarative' 'libglvnd')
makedepends=('cmake' 'ninja' 'patchelf' 'qt6-tools')
optdepends=('nvidia-utils: NVML GPU probe for optional AnimeJaNai components')
# A stripped single package: this is a release build, not a rebuild service.
options=('strip' '!debug')
# The bundled runtime is our TLS-enabled libmpv, not the distribution's: the
# player is built against that fork, and a system libmpv cannot provide it.
_mpvver='2026-10-24-c493f1c-tls'
source=("mikai-$pkgver.tar.gz" "mpv-linux-x64-$_mpvver.tar.zst")
sha256sums=('@SHA256@' '@MPV_SHA256@')
_revision='@REVISION@'

build() {
  # The driver passes the cached pinned Anime4K tarball when it has one, so the
  # package build does not depend on network access for third-party shaders.
  local anime4k_args=()
  if [[ -n "${MIKAI_ANIME4K_ARCHIVE:-}" && -f "${MIKAI_ANIME4K_ARCHIVE}" ]]; then
    anime4k_args+=(-DMIKAI_ANIME4K_ARCHIVE="${MIKAI_ANIME4K_ARCHIVE}")
  fi
  cmake -S "$srcdir/mikai-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMIKAI_BUILD_REVISION="$_revision" \
    -DMIKAI_LINUX_BUNDLE_MPV=ON \
    -DMIKAI_LINUX_DEPLOY_QT=OFF \
    -DMIKAI_LINUX_MPV_ARCHIVE="$srcdir/mpv-linux-x64-$_mpvver.tar.zst" \
    -DMIKAI_LINUX_MPV_INSTALL_SUBDIR=lib/mikai/mpv \
    "${anime4k_args[@]}"
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure --timeout 900 --no-tests=error
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$srcdir/mikai-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
