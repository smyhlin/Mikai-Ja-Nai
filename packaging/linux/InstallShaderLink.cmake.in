set(shader_link "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/shaders")
if(EXISTS "${shader_link}" OR IS_SYMLINK "${shader_link}")
  if(NOT IS_SYMLINK "${shader_link}")
    message(FATAL_ERROR "Refusing to replace a non-symlink shader path: ${shader_link}")
  endif()
  file(READ_SYMLINK "${shader_link}" shader_target)
  if(NOT shader_target STREQUAL "@mikai_linux_shaders_from_bin@")
    message(FATAL_ERROR "Refusing to replace an unowned shader symlink: ${shader_link}")
  endif()
else()
  file(CREATE_LINK "@mikai_linux_shaders_from_bin@" "${shader_link}"
    SYMBOLIC RESULT shader_link_result)
  if(NOT shader_link_result STREQUAL "0")
    message(FATAL_ERROR "Could not install shader symlink: ${shader_link_result}")
  endif()
endif()
