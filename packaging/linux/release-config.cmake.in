set(MIKAI_LINUX_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
set(MIKAI_LINUX_QT_VERSION "@Qt6_VERSION@")
set(MIKAI_LINUX_QT_PLUGIN_DIR "@MIKAI_LINUX_QT_PLUGIN_DIR@")
set(MIKAI_LINUX_COMPILER "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@")
