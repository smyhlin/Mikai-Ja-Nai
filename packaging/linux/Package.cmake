cmake_minimum_required(VERSION 3.25)
foreach(required BUILD_DIR OUTPUT_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required.")
  endif()
endforeach()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
if(NOT EXISTS "${BUILD_DIR}/mikai-linux-release.cmake")
  message(FATAL_ERROR "Not a configured Mikai Linux build: ${BUILD_DIR}")
endif()
include("${BUILD_DIR}/mikai-linux-release.cmake")
if(MIKAI_LINUX_WITH_NATIVE OR MIKAI_LINUX_DIST_NATIVE OR MIKAI_LINUX_WITH_MODEL_INSPECTION)
  message(FATAL_ERROR
    "Public Linux packages contain Original playback and Anime4K only. Optional native "
    "inference and model-inspection support is not established; disable native, "
    "model inspection and native distribution options before public packaging.")
endif()
if(NOT DEFINED CONFIG OR CONFIG STREQUAL "")
  set(CONFIG "Release")
endif()
if(NOT CONFIG STREQUAL "Release")
  message(FATAL_ERROR "Linux public archives require the Release configuration, not '${CONFIG}'.")
endif()
if(NOT MIKAI_LINUX_BUILD_TYPE STREQUAL "" AND NOT MIKAI_LINUX_BUILD_TYPE STREQUAL "Release")
  message(FATAL_ERROR
    "Linux public archives require a build configured with -DCMAKE_BUILD_TYPE=Release.")
endif()
# A fresh owned output directory is required even if an old one looks empty.
# No package command removes, overwrites, or sweeps existing deployments.
if(EXISTS "${OUTPUT_DIR}" OR IS_SYMLINK "${OUTPUT_DIR}")
  message(FATAL_ERROR "Output already exists; choose a fresh directory: ${OUTPUT_DIR}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(package_name "mikai-${MIKAI_LINUX_VERSION}-linux-x86_64")
set(STAGE_DIR "${OUTPUT_DIR}/${package_name}")
include("${CMAKE_CURRENT_LIST_DIR}/Stage.cmake")
set(archive_name "${package_name}.tar.gz")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cfz "${archive_name}"
  --format=gnutar "${package_name}"
  WORKING_DIRECTORY "${OUTPUT_DIR}" RESULT_VARIABLE archive_result)
if(NOT archive_result EQUAL 0)
  message(FATAL_ERROR "Archive failed (${archive_result}); owned staging tree retained at ${STAGE_DIR}.")
endif()
file(SHA256 "${OUTPUT_DIR}/${archive_name}" archive_digest)
file(WRITE "${OUTPUT_DIR}/SHA256SUMS" "${archive_digest}  ${archive_name}\n")
message(STATUS "Created ${OUTPUT_DIR}/${archive_name}")
include("${CMAKE_CURRENT_LIST_DIR}/Contract.cmake")
message(STATUS "Dependency-based archive only; no AppImage, deb, signing or publication is performed.")
