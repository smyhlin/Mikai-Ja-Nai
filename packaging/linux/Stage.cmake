cmake_minimum_required(VERSION 3.25)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "Linux staging requires a Linux host.")
endif()
foreach(required BUILD_DIR STAGE_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required.")
  endif()
endforeach()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
get_filename_component(STAGE_DIR "${STAGE_DIR}" ABSOLUTE)
if(NOT EXISTS "${BUILD_DIR}/mikai-linux-release.cmake"
    OR NOT EXISTS "${BUILD_DIR}/cmake_install.cmake")
  message(FATAL_ERROR "Not a configured Mikai Linux build: ${BUILD_DIR}")
endif()
include("${BUILD_DIR}/mikai-linux-release.cmake")
if(MIKAI_LINUX_WITH_NATIVE OR MIKAI_LINUX_DIST_NATIVE OR MIKAI_LINUX_WITH_MODEL_INSPECTION)
  message(FATAL_ERROR
    "Public Linux packages contain Original playback and Anime4K only. Optional native "
    "inference and model-inspection support is not established; disable native, "
    "model inspection and native distribution options before public packaging.")
endif()
if(IS_SYMLINK "${STAGE_DIR}")
  message(FATAL_ERROR "Refusing a symlink staging directory: ${STAGE_DIR}")
endif()
if(EXISTS "${STAGE_DIR}")
  file(GLOB existing_entries LIST_DIRECTORIES TRUE "${STAGE_DIR}/*" "${STAGE_DIR}/.[!.]*" "${STAGE_DIR}/..?*")
  if(existing_entries OR NOT IS_DIRECTORY "${STAGE_DIR}")
    message(FATAL_ERROR "Refusing to modify populated staging path: ${STAGE_DIR}. Choose a fresh directory.")
  endif()
endif()
if(NOT DEFINED CONFIG OR CONFIG STREQUAL "")
  set(CONFIG "Release")
endif()
if(MIKAI_LINUX_MPV_HEADER_PKGCONFIG STREQUAL "")
  set(MIKAI_LINUX_MPV_HEADER_PKGCONFIG "unknown (manual host development headers selection)")
endif()
file(MAKE_DIRECTORY "${STAGE_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}"
  --config "${CONFIG}" --prefix "${STAGE_DIR}"
  RESULT_VARIABLE install_result)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "Linux install failed (${install_result}); incomplete owned stage retained at ${STAGE_DIR}.")
endif()
if(NOT EXISTS "${STAGE_DIR}/${MIKAI_LINUX_BINDIR}/mikai")
  message(FATAL_ERROR "The install did not produce the Mikai executable.")
endif()
if(MIKAI_LINUX_MPV_BUNDLE)
  set(installed_mpv "${STAGE_DIR}/${MIKAI_LINUX_MPV_MODULE_RELATIVE}")
  if(NOT EXISTS "${installed_mpv}" OR IS_SYMLINK "${installed_mpv}" OR IS_DIRECTORY "${installed_mpv}")
    message(FATAL_ERROR "The install did not produce the regular bundled libmpv module: ${installed_mpv}")
  endif()
endif()
execute_process(COMMAND git -C "${MIKAI_LINUX_SOURCE_DIR}" rev-parse HEAD
  OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
  RESULT_VARIABLE revision_result)
if(NOT revision_result EQUAL 0)
  set(revision "unknown (source archive without Git metadata)")
endif()
string(TIMESTAMP package_time "%Y-%m-%dT%H:%M:%SZ" UTC)
if(MIKAI_LINUX_MPV_MODE STREQUAL "bundled")
  if(MIKAI_LINUX_DEPLOY_QT)
    set(dependency_mode "Qt deployed; pinned libmpv and private dependencies bundled under ${MIKAI_LINUX_BINDIR}/mpv with $ORIGIN RUNPATH; glibc/loader/graphics remain host dependencies")
  else()
    set(dependency_mode "system Qt/plugins; pinned libmpv and private dependencies bundled under ${MIKAI_LINUX_BINDIR}/mpv with $ORIGIN RUNPATH; glibc/loader/graphics remain host dependencies")
  endif()
else()
  if(MIKAI_LINUX_DEPLOY_QT)
    set(dependency_mode "Qt deployed; libmpv/FFmpeg/graphics/system libraries remain host dependencies")
  else()
    set(dependency_mode "system Qt/plugins, libmpv/FFmpeg, graphics and C/C++ runtime dependencies; not standalone")
  endif()
endif()
set(libc "unknown")
execute_process(COMMAND getconf GNU_LIBC_VERSION OUTPUT_VARIABLE detected_libc
  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE libc_result)
if(libc_result EQUAL 0)
  set(libc "${detected_libc}")
endif()
file(WRITE "${STAGE_DIR}/VERSION"
  "Mikai ${MIKAI_LINUX_VERSION}\nplatform=linux-x86_64\nrevision=${revision}\npackaged_at=${package_time}\nconfiguration=${CONFIG}\ncompiler=${MIKAI_LINUX_COMPILER}\nqt=${MIKAI_LINUX_QT_VERSION}\nmpv_mode=${MIKAI_LINUX_MPV_MODE}\nmpv_header_pkgconfig=${MIKAI_LINUX_MPV_HEADER_PKGCONFIG}\nmpv_runtime_identity=${MIKAI_LINUX_MPV_RUNTIME_IDENTITY}\nmpv_module=${MIKAI_LINUX_MPV_MODULE_RELATIVE}\nmpv_bundle=${MIKAI_LINUX_MPV_BUNDLE}\nmpv_archive_sha256=${MIKAI_LINUX_MPV_ARCHIVE_SHA256}\nmpv_patched_runpath=${MIKAI_LINUX_MPV_PATCHED_RUNPATH}\npackaging_host_libc=${libc}\ndependencies=${dependency_mode}\n")
file(GLOB_RECURSE payload_files LIST_DIRECTORIES FALSE RELATIVE "${STAGE_DIR}" "${STAGE_DIR}/*")
list(SORT payload_files)
file(WRITE "${STAGE_DIR}/SHA256SUMS" "")
foreach(payload IN LISTS payload_files)
  if(NOT IS_SYMLINK "${STAGE_DIR}/${payload}" AND NOT payload STREQUAL "SHA256SUMS")
    file(SHA256 "${STAGE_DIR}/${payload}" digest)
    file(APPEND "${STAGE_DIR}/SHA256SUMS" "${digest}  ${payload}\n")
  endif()
endforeach()
message(STATUS "Linux stage assembled at ${STAGE_DIR}; runtime and redistribution validation are separate release gates.")
