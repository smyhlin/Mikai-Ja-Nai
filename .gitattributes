# Normalize line endings in the repository; check out per-platform below.
* text=auto eol=lf

# Windows scripts need CRLF to run from cmd.exe
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are never line-ending translated
*.png binary
*.ico binary
*.dll binary
*.7z binary
*.exe binary

# Lockfiles stay LF
uv.lock text eol=lf
