# Materialise, verify or move the pinned Anime4K GLSL set.
#
# One script, three modes, run through `cmake -P` so the build, the test suite and
# a maintainer use exactly the same code and no interpreter beyond CMake:
#
#   cmake -DMODE=fetch -DMANIFEST=... -DSHADERS_DIR=... -DCACHE_DIR=... [-DARCHIVE=...] -P FetchAnime4K.cmake
#   cmake -DMODE=check -DMANIFEST=... -DSHADERS_DIR=... -P FetchAnime4K.cmake
#   cmake -DMODE=pin -DCOMMIT=<sha> -DMANIFEST=... -DSHADERS_DIR=... -P FetchAnime4K.cmake
#
# fetch: one tarball of the pinned commit (downloaded once into CACHE_DIR, or a
# local ARCHIVE), every file checked against the manifest's SHA-256 before it is
# written. check: the staged tree still matches the manifest. pin: rewrite the
# manifest and the staged tree for another upstream commit.

cmake_minimum_required(VERSION 3.25)

foreach(required MODE MANIFEST SHADERS_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Anime4K fetch: ${required} is required")
  endif()
endforeach()

set(_repo "bloc97/Anime4K")
file(READ "${MANIFEST}" _a4k_manifest)
string(JSON _a4k_entries LENGTH "${_a4k_manifest}" files)

function(_a4k_report message)
  message(STATUS "shaders: ${message}")
endfunction()

function(_a4k_manifest_field index name out)
  string(JSON _value GET "${_a4k_manifest}" files ${index} ${name})
  set(${out} "${_value}" PARENT_SCOPE)
endfunction()

# Parses the manifest into parallel lists: upstream paths, digests and sizes.
function(_a4k_load_manifest)
  set(paths "")
  set(digests "")
  set(sizes "")
  math(EXPR _last "${_a4k_entries} - 1")
  if(_last LESS 0)
    message(FATAL_ERROR "Anime4K fetch: the manifest lists no files")
  endif()
  foreach(index RANGE ${_last})
    _a4k_manifest_field(${index} path path)
    _a4k_manifest_field(${index} sha256 digest)
    _a4k_manifest_field(${index} size size)
    if(NOT path OR NOT digest)
      message(FATAL_ERROR "Anime4K fetch: manifest entry ${index} is incomplete")
    endif()
    list(APPEND paths "${path}")
    list(APPEND digests "${digest}")
    list(APPEND sizes "${size}")
  endforeach()
  set(A4K_PATHS "${paths}" PARENT_SCOPE)
  set(A4K_DIGESTS "${digests}" PARENT_SCOPE)
  set(A4K_SIZES "${sizes}" PARENT_SCOPE)
  set(A4K_PATHS "${paths}" PARENT_SCOPE)
  set(A4K_DIGESTS "${digests}" PARENT_SCOPE)
  set(A4K_SIZES "${sizes}" PARENT_SCOPE)
endfunction()

function(_a4k_write_pin commit stamp)
  string(TIMESTAMP _now "%Y-%m-%dT%H:%M:%SZ" UTC)
  file(WRITE "${stamp}" "${commit}\n${_now}\n")
endfunction()

# A CMake function has no return value, so the caller names the variable that
# collects problems; the parameter must not share that name or the indirect
# append would write into the parameter itself.
function(_a4k_verify_entry target path digest size problems_var)
  set(found "")
  if(NOT EXISTS "${target}")
    list(APPEND found "missing ${path}")
  else()
    file(SHA256 "${target}" actual)
    file(SIZE "${target}" actual_size)
    if(NOT actual STREQUAL digest)
      list(APPEND found "changed ${path}: manifest ${digest}, tree ${actual}")
    elseif(NOT actual_size EQUAL size)
      list(APPEND found "changed ${path}: manifest ${size} bytes, tree ${actual_size}")
    endif()
  endif()
  set(${problems_var} "${found}" PARENT_SCOPE)
endfunction()

function(_a4k_check)
  _a4k_load_manifest()
  set(problems "")
  set(names "")
  list(LENGTH A4K_PATHS count)
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    list(GET A4K_PATHS ${index} path)
    list(GET A4K_DIGESTS ${index} digest)
    list(GET A4K_SIZES ${index} size)
    get_filename_component(name "${path}" NAME)
    list(APPEND names "${name}")
    _a4k_verify_entry("${SHADERS_DIR}/${name}" "${path}" "${digest}" "${size}" entry_problems)
    list(APPEND problems ${entry_problems})
  endforeach()
  file(GLOB staged "${SHADERS_DIR}/*.glsl")
  foreach(file IN LISTS staged)
    get_filename_component(name "${file}" NAME)
    if(NOT name IN_LIST names)
      list(APPEND problems "unlisted ${name}")
    endif()
  endforeach()
  if(problems)
    string(REPLACE ";" "\n  " _report "${problems}")
    message(FATAL_ERROR "Anime4K fetch: staged shaders disagree with the manifest:\n  ${_report}")
  endif()
  if(NOT count EQUAL 0)
    string(JSON _commit GET "${_a4k_manifest}" commit)
    string(SUBSTRING "${_commit}" 0 12 _short)
    _a4k_report("${count} files match ${_repo}@${_short}")
  endif()
endfunction()

function(_a4k_fetch)
  string(JSON commit GET "${_a4k_manifest}" commit)
  string(LENGTH "${commit}" commit_length)
  if(NOT commit_length EQUAL 40)
    message(FATAL_ERROR "Anime4K fetch: the manifest pins no full commit (${commit})")
  endif()
  if(DEFINED ARCHIVE AND NOT ARCHIVE STREQUAL "")
    set(archive "${ARCHIVE}")
    if(NOT EXISTS "${archive}")
      message(FATAL_ERROR "Anime4K fetch: the local archive does not exist: ${archive}")
    endif()
  else()
    set(archive "${CACHE_DIR}/anime4k-${commit}.tar.gz")
    if(NOT EXISTS "${archive}")
      file(MAKE_DIRECTORY "${CACHE_DIR}")
      message(STATUS "shaders: downloading ${_repo}@${commit} into ${CACHE_DIR}")
      file(DOWNLOAD "https://codeload.github.com/${_repo}/tar.gz/${commit}" "${archive}"
        STATUS download_status
        TLS_VERIFY ON)
      list(GET download_status 0 download_code)
      list(GET download_status 1 download_message)
      if(NOT download_code EQUAL 0)
        file(REMOVE "${archive}")
        message(FATAL_ERROR
          "Anime4K fetch: cannot download ${_repo}@${commit}: ${download_message}\n"
          "Build offline with -DMIKAI_ANIME4K_ARCHIVE=<tar.gz of that commit>.")
      endif()
    endif()
  endif()

  set(extract "${CACHE_DIR}/extract-${commit}")
  file(REMOVE_RECURSE "${extract}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
  file(GLOB_RECURSE extracted "${extract}/*/glsl/*.glsl")

  _a4k_load_manifest()
  set(problems "")
  list(LENGTH A4K_PATHS count)
  math(EXPR last "${count} - 1")
  file(MAKE_DIRECTORY "${SHADERS_DIR}")
  foreach(index RANGE ${last})
    list(GET A4K_PATHS ${index} path)
    list(GET A4K_DIGESTS ${index} digest)
    list(GET A4K_SIZES ${index} size)
    get_filename_component(name "${path}" NAME)
    # A 'Upscale+Denoise' path is a regex with a quantifier, so the expected
    # suffix is escaped before it is matched.
    string(REGEX REPLACE "([][+.*?()^$\\\\|])" "\\\\\\1" path_pattern "${path}")
    set(source "")
    foreach(candidate IN LISTS extracted)
      if(candidate MATCHES "/${path_pattern}$")
        set(source "${candidate}")
        break()
      endif()
    endforeach()
    if(source STREQUAL "")
      list(APPEND problems "${path} is not in the ${commit} archive")
      continue()
    endif()
    file(SHA256 "${source}" actual)
    if(NOT actual STREQUAL digest)
      list(APPEND problems "${path} does not match the manifest digest")
      continue()
    endif()
    file(SIZE "${source}" actual_size)
    if(NOT actual_size EQUAL size)
      list(APPEND problems "${path} does not match the manifest size")
      continue()
    endif()
    file(COPY_FILE "${source}" "${SHADERS_DIR}/${name}" ONLY_IF_DIFFERENT)
  endforeach()
  file(REMOVE_RECURSE "${extract}")

  if(problems)
    string(REPLACE ";" "\n  " _report "${problems}")
    message(FATAL_ERROR "Anime4K fetch: the pinned archive does not match the manifest:\n  ${_report}")
  endif()
  _a4k_write_pin("${commit}" "${SHADERS_DIR}/anime4k-pin.txt")
  string(SUBSTRING "${commit}" 0 12 short)
  _a4k_report("${count} files staged from ${_repo}@${short} in ${SHADERS_DIR}")
endfunction()

function(_a4k_pin)
  if(NOT DEFINED COMMIT OR NOT COMMIT MATCHES "^[0-9a-f]{40}$")
    message(FATAL_ERROR "Anime4K fetch: MODE=pin needs COMMIT=<40 hex characters>")
  endif()
  set(tree_file "${CACHE_DIR}/tree-${COMMIT}.json")
  file(MAKE_DIRECTORY "${CACHE_DIR}")
  file(DOWNLOAD "https://api.github.com/repos/${_repo}/git/trees/${COMMIT}?recursive=1"
    "${tree_file}"
    HTTPHEADER "User-Agent: mikai-anime4k-fetch"
    STATUS tree_status
    TLS_VERIFY ON)
  list(GET tree_status 0 tree_code)
  list(GET tree_status 1 tree_message)
  if(NOT tree_code EQUAL 0)
    file(REMOVE "${tree_file}")
    message(FATAL_ERROR "Anime4K pin: cannot list ${COMMIT}: ${tree_message}")
  endif()
  file(READ "${tree_file}" tree)
  string(JSON entries LENGTH "${tree}" tree)
  math(EXPR last "${entries} - 1")

  set(paths "")
  foreach(index RANGE ${last})
    string(JSON kind GET "${tree}" tree ${index} type)
    if(NOT kind STREQUAL "blob")
      continue()
    endif()
    string(JSON path GET "${tree}" tree ${index} path)
    if(path MATCHES "^glsl/.+\\.glsl$")
      list(APPEND paths "${path}")
    endif()
  endforeach()
  list(LENGTH paths count)
  if(count EQUAL 0)
    message(FATAL_ERROR "Anime4K pin: ${COMMIT} publishes no glsl files")
  endif()

  set(manifest
    "{\n  \"upstream\": \"https://github.com/${_repo}\",\n  \"commit\": \"${COMMIT}\",\n  \"license\": \"MIT and Unlicense, per file header; see licenses/\",\n  \"files\": [\n")
  set(separator "")
  foreach(path IN LISTS paths)
    get_filename_component(name "${path}" NAME)
    file(DOWNLOAD "https://raw.githubusercontent.com/${_repo}/${COMMIT}/${path}"
      "${CACHE_DIR}/${name}" STATUS file_status TLS_VERIFY ON)
    list(GET file_status 0 file_code)
    list(GET file_status 1 file_message)
    if(NOT file_code EQUAL 0)
      message(FATAL_ERROR "Anime4K pin: cannot download ${path}: ${file_message}")
    endif()
    file(SHA256 "${CACHE_DIR}/${name}" digest)
    file(SIZE "${CACHE_DIR}/${name}" size)
    file(COPY_FILE "${CACHE_DIR}/${name}" "${SHADERS_DIR}/${name}" ONLY_IF_DIFFERENT)
    file(REMOVE "${CACHE_DIR}/${name}")
    string(APPEND manifest "${separator}    {\n      \"path\": \"${path}\",\n      \"sha256\": \"${digest}\",\n      \"size\": ${size}\n    }")
    set(separator ",\n")
  endforeach()
  string(APPEND manifest "\n  ]\n}\n")
  file(WRITE "${MANIFEST}" "${manifest}")
  _a4k_write_pin("${COMMIT}" "${SHADERS_DIR}/anime4k-pin.txt")
  string(SUBSTRING "${COMMIT}" 0 12 short)
  _a4k_report("${count} files pinned to ${_repo}@${short}")
endfunction()

if(MODE STREQUAL "check")
  _a4k_check()
elseif(MODE STREQUAL "fetch")
  _a4k_fetch()
elseif(MODE STREQUAL "pin")
  _a4k_pin()
else()
  message(FATAL_ERROR "Anime4K fetch: unknown MODE '${MODE}'")
endif()
