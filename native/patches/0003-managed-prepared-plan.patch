+/* ---------------- source-shape transform (managed prepared path) ---------------- */
+
+// Crop+rotate one plane whose samples are one (bpp=1) or two (bpp=2) bytes
+// wide. Crop and dims are in plane samples; rotation is clockwise and swaps
+// the output dims for 90/270.
+__global__ void k_plane_crop_rotate(const uint8_t *src, ptrdiff_t sstride,
+                                    int bpp, int cx, int cy, int cw, int ch,
+                                    int rotation, uint8_t *dst,
+                                    ptrdiff_t dstride, int dw, int dh)
+{
+    const int dx = blockIdx.x * blockDim.x + threadIdx.x;
+    const int dy = blockIdx.y * blockDim.y + threadIdx.y;
+    if (dx >= dw || dy >= dh)
+        return;
+    int sx, sy;
+    switch (rotation) {
+    case 90:  sx = cx + dy;            sy = cy + (ch - 1 - dx); break;
+    case 180: sx = cx + (cw - 1 - dx); sy = cy + (ch - 1 - dy); break;
+    case 270: sx = cx + (cw - 1 - dy); sy = cy + dx; break;
+    default:  sx = cx + dx;            sy = cy + dy; break;
+    }
+    if (bpp == 2) {
+        ((uint16_t *)(dst + (size_t)dy * dstride))[dx] =
+            ((const uint16_t *)(src + (size_t)sy * sstride))[sx];
+    } else {
+        dst[(size_t)dy * dstride + dx] = src[(size_t)sy * sstride + sx];
+    }
+}
+
+// Crop+rotate the interleaved 4:2:0 chroma plane. The plane holds one sample
+// per luma x (Cb and Cr alternating) and one row per two luma rows, so a crop
+// of any parity maps by whole chroma pairs (ceil on odd extents) with the
+// component alignment preserved. 90/270 move the 2:1 subsampling axis, so the
+// rotated output pairs come from the rotated chroma PAIR grid, not from
+// rotating the byte array. cx/cy are the cropped start in PAIR coordinates;
+// cwp/chp are the cropped pair extents.
+__global__ void k_chroma420_crop_rotate(const uint8_t *src, ptrdiff_t sstride,
+                                        int bpp, int sw, int sh2,
+                                        int cx, int cy, int cwp, int chp,
+                                        int rotation, uint8_t *dst,
+                                        ptrdiff_t dstride, int dw, int dh2)
+{
+    const int ox = blockIdx.x * blockDim.x + threadIdx.x;
+    const int oy = blockIdx.y * blockDim.y + threadIdx.y;
+    if (ox >= dw || oy >= dh2)
+        return;
+    const int comp = ox & 1;      // 0 = Cb, 1 = Cr
+    const int pu = ox >> 1;       // output pair index within the row
+    int a, b;
+    switch (rotation) {
+    case 90:  a = oy;             b = chp - 1 - pu; break;
+    case 180: a = cwp - 1 - pu;   b = chp - 1 - oy; break;
+    case 270: a = cwp - 1 - oy;   b = pu; break;
+    default:  a = pu;             b = oy; break;
+    }
+    const int sx = 2 * (cx + a) + comp;
+    const int sy = cy + b;
+    if (sx < 0 || sx >= sw || sy < 0 || sy >= sh2)
+        return;
+    if (bpp == 2) {
+        ((uint16_t *)(dst + (size_t)oy * dstride))[ox] =
+            ((const uint16_t *)(src + (size_t)sy * sstride))[sx];
+    } else {
+        dst[(size_t)oy * dstride + ox] = src[(size_t)sy * sstride + sx];
+    }
+}
+
+extern "C" int aji_run_yuv_crop_rotate(int format,
+                                       const void *const *src_planes,
+                                       const ptrdiff_t *src_strides,
+                                       int src_w, int src_h,
+                                       int crop_x, int crop_y, int crop_w,
+                                       int crop_h, int rotation,
+                                       void *const *dst_planes,
+                                       const ptrdiff_t *dst_strides,
+                                       void *stream)
+{
+    if (!src_planes || !dst_planes || !src_strides || !dst_strides)
+        return (int)cudaErrorInvalidValue;
+    if (src_w < 1 || src_h < 1 || crop_w < 1 || crop_h < 1)
+        return (int)cudaErrorInvalidValue;
+    if (crop_x < 0 || crop_y < 0 || crop_x + crop_w > src_w ||
+        crop_y + crop_h > src_h)
+        return (int)cudaErrorInvalidValue;
+    const bool swap = rotation == 90 || rotation == 270;
+    const int dw = swap ? crop_h : crop_w;
+    const int dh = swap ? crop_w : crop_h;
+    const int bpp = format == AJI_FMT_NV12 ? 1 : 2;
+    cudaStream_t s = (cudaStream_t)stream;
+
+    if (format == AJI_FMT_YUV444P16) {
+        for (int p = 0; p < 3; p++) {
+            k_plane_crop_rotate<<<GRID(dw, dh, 1), 0, s>>>(
+                (const uint8_t *)src_planes[p], src_strides[p], bpp,
+                crop_x, crop_y, crop_w, crop_h, rotation,
+                (uint8_t *)dst_planes[p], dst_strides[p], dw, dh);
+        }
+        return (int)cudaGetLastError();
+    }
+
+    // 4:2:0: luma plane plus the interleaved chroma below it. Chroma maps by
+    // whole pairs (ceil on an odd extent) and keeps Cb/Cr aligned; the crop
+    // start is aligned down to the containing pair row/column.
+    k_plane_crop_rotate<<<GRID(dw, dh, 1), 0, s>>>(
+        (const uint8_t *)src_planes[0], src_strides[0], bpp,
+        crop_x, crop_y, crop_w, crop_h, rotation,
+        (uint8_t *)dst_planes[0], dst_strides[0], dw, dh);
+    const int sw = src_w;                       // chroma samples per row
+    const int sh2 = (src_h + 1) >> 1;           // chroma rows
+    const int dh2 = (dh + 1) >> 1;
+    if (dh2 > 0 && sw > 0)
+        k_chroma420_crop_rotate<<<GRID(dw, dh2, 1), 0, s>>>(
+            (const uint8_t *)src_planes[1], src_strides[1], bpp, sw, sh2,
+            crop_x >> 1, crop_y >> 1, (crop_w + 1) >> 1, (crop_h + 1) >> 1,
+            rotation, (uint8_t *)dst_planes[1], dst_strides[1], dw, dh2);
+    return (int)cudaGetLastError();
+}
