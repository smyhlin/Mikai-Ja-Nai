+extern "C" AJI_EXPORT aji_ctx *aji_native_backend_create_prepared(
+    const aji_create_params *params, const aji_native_prepared_plan_v1 *plan,
+    aji_native_snapshot_v2 *s)
+{
+    if (!params || params->api_version != AJI_API_VERSION) {
+        mg_fill_refusal(nullptr, s, AJI_NATIVE_INVALID_ARGUMENT,
+                        "create_prepared requires matching aji_create_params");
+        return nullptr;
+    }
+    if (!plan) {
+        mg_fill_refusal(nullptr, s, AJI_NATIVE_INVALID_ARGUMENT,
+                        "create_prepared requires a plan");
+        return nullptr;
+    }
+    auto c = std::make_unique<aji_ctx>();
+    c->logger.fn = params->log;
+    c->logger.opaque = params->log_opaque;
+    c->graph_ok = !getenv("AJI_NO_GRAPH");
+    if (cuInit(0) != CUDA_SUCCESS) {
+        mg_fill_refusal(c.get(), s, AJI_NATIVE_OPERATION_FAILED, "cuInit failed");
+        return nullptr;
+    }
+    if (params->cuda_context) {
+        c->cu_ctx = (CUcontext)params->cuda_context;
+    } else {
+        CUdevice dev;
+        if (cuDeviceGet(&dev, 0) != CUDA_SUCCESS ||
+            cuDevicePrimaryCtxRetain(&c->cu_ctx, dev) != CUDA_SUCCESS) {
+            mg_fill_refusal(c.get(), s, AJI_NATIVE_OPERATION_FAILED,
+                            "failed to retain the primary CUDA context");
+            return nullptr;
+        }
+        c->owns_primary = true;
+    }
+    c->runtime.reset(nvinfer1::createInferRuntime(c->logger));
+    if (!c->runtime) {
+        if (c->owns_primary) {
+            CUdevice d;
+            if (cuDeviceGet(&d, 0) == CUDA_SUCCESS)
+                cuDevicePrimaryCtxRelease(d);
+        }
+        mg_fill_refusal(c.get(), s, AJI_NATIVE_OPERATION_FAILED,
+                        "createInferRuntime failed");
+        return nullptr;
+    }
+    std::string why;
+    const int rc = managed_apply(c.get(), plan, &why);
+    if (rc != AJI_NATIVE_OK) {
+        c->set_error("prepared admission refused: %s", why.c_str());
+        mg_fill_refusal(c.get(), s, rc,
+                        ("prepared admission refused: " + why).c_str());
+        if (c->owns_primary) {
+            CUdevice d;
+            if (cuDeviceGet(&d, 0) == CUDA_SUCCESS)
+                cuDevicePrimaryCtxRelease(d);
+        }
+        return nullptr;
+    }
+    return c.release();
+}
