+// Fill a frame descriptor for a tightly packed scratch surface of the given
+// format and luma dims.
+static void managed_yuv_descriptor(int format, int w, int h, void *base,
+                                   aji_frame *f)
+{
+    memset(f, 0, sizeof(*f));
+    const int bpp = format == AJI_FMT_NV12 ? 1 : 2;
+    const size_t plane = (size_t)w * h * bpp;
+    f->width = w;
+    f->height = h;
+    f->format = format;
+    f->plane[0] = base;
+    f->stride[0] = (ptrdiff_t)((size_t)w * bpp);
+    if (format == AJI_FMT_YUV444P16) {
+        f->plane[1] = (char *)base + plane;
+        f->plane[2] = (char *)base + 2 * plane;
+        f->stride[1] = f->stride[2] = f->stride[0];
+    } else {
+        f->plane[1] = (char *)base + plane;
+        f->plane[2] = nullptr;
+        f->stride[1] = f->stride[0];
+    }
+}
+
+// Observe the caller's coded frame (dims and pitch) and, when the admitted
+// plan crops or rotates, map it on the GPU into the display-size scratch
+// frame. A frame already at the display size is used as-is (the filter feeds
+// the interpolated frames back at that geometry).
+static bool managed_normalize_frame(aji_ctx *c, const aji_frame *in, int slot,
+                                    void *stream, aji_frame *out,
+                                    std::string *why)
+{
+    *out = *in;
+    if (!c->has_source_transform)
+        return true;
+    if (in->width == c->managed_display_w && in->height == c->managed_display_h)
+        return true;
+    if (in->width != c->managed_coded_w || in->height != c->managed_coded_h) {
+        *why = "frame " + std::to_string(in->width) + "x" +
+               std::to_string(in->height) + " is neither the prepared coded " +
+               std::to_string(c->managed_coded_w) + "x" +
+               std::to_string(c->managed_coded_h) + " source nor its display " +
+               std::to_string(c->managed_display_w) + "x" +
+               std::to_string(c->managed_display_h);
+        return false;
+    }
+    const int bpp = in->format == AJI_FMT_NV12 ? 1 : 2;
+    const ptrdiff_t row = (ptrdiff_t)((size_t)in->width * bpp);
+    if (in->stride[0] < row ||
+        (in->format == AJI_FMT_YUV444P16 ? in->stride[2] < row
+                                         : in->stride[1] < row)) {
+        *why = "frame pitch is smaller than the coded row";
+        return false;
+    }
+    // An odd crop extent is a legitimate source property: the kernel maps the
+    // 4:2:0 chroma by whole pairs (ceil) and the chain's first stage geometry
+    // is even, so the initial resize lands on an even tensor.
+    void *scratch = c->src_scratch[slot];
+    if (!scratch) {
+        *why = "source transform scratch is not allocated";
+        return false;
+    }
+    aji_frame dst;
+    managed_yuv_descriptor(in->format, c->managed_display_w,
+                           c->managed_display_h, scratch, &dst);
+    dst.matrix = in->matrix;
+    dst.range = in->range;
+    dst.siting = in->siting;
+    const bool p444 = in->format == AJI_FMT_YUV444P16;
+    const void *sp[3] = {in->plane[0], in->plane[1], in->plane[2]};
+    ptrdiff_t ss[3] = {in->stride[0], in->stride[1], in->stride[2]};
+    void *dp[3] = {dst.plane[0], dst.plane[1], dst.plane[2]};
+    ptrdiff_t ds[3] = {dst.stride[0], dst.stride[1], dst.stride[2]};
+    if (!p444) {
+        sp[2] = nullptr;
+        ss[2] = 0;
+        dp[2] = nullptr;
+        ds[2] = 0;
+    }
+    const int err = aji_run_yuv_crop_rotate(
+        in->format, sp, ss, c->managed_coded_w, c->managed_coded_h,
+        c->managed_crop_x, c->managed_crop_y, c->managed_crop_w,
+        c->managed_crop_h, c->managed_rotation, dp, ds, stream);
+    if (err) {
+        *why = std::string("source crop/rotate kernel failed: ") +
+               cudaGetErrorString((cudaError_t)err);
+        return false;
+    }
+    *out = dst;
+    return true;
+}
+
+// aji_infer for an admitted prepared plan: observe/normalize the coded source
+// frame, then run the planned chain and post-process to the oriented output.
+static int managed_infer(aji_ctx *c, const aji_frame *in,
+                         const aji_frame *out, void *cu_stream)
+{
+    if (!c->managed_ready) {
+        c->set_error("prepared plan is not loaded");
+        return AJI_ERR;
+    }
+    if (in->format != AJI_FMT_NV12 && in->format != AJI_FMT_P010 &&
+        in->format != AJI_FMT_YUV444P16) {
+        c->set_error("unsupported input format %d", in->format);
+        return AJI_ERR_FORMAT;
+    }
+    if (out->format != AJI_FMT_NV12 && out->format != AJI_FMT_P010 &&
+        out->format != AJI_FMT_YUV444P16) {
+        c->set_error("unsupported output format %d (nv12/p010/yuv444p16)",
+                     out->format);
+        return AJI_ERR_FORMAT;
+    }
+    if (out->width != c->out_w || out->height != c->out_h) {
+        c->set_error("output dims %dx%d do not match the prepared %dx%d",
+                     out->width, out->height, c->out_w, c->out_h);
+        return AJI_ERR_SHAPE;
+    }
+    CtxGuard guard(c->cu_ctx);
+    if (!guard.ok) {
+        c->set_error("cuCtxPushCurrent failed");
+        return AJI_ERR_CUDA;
+    }
+    cudaStream_t stream = (cudaStream_t)cu_stream;
+    aji_frame norm;
+    std::string why;
+    if (!managed_normalize_frame(c, in, 0, cu_stream, &norm, &why)) {
+        c->set_error("prepared source geometry refused: %s", why.c_str());
+        return AJI_ERR_SHAPE;
+    }
+    if (c->graph_ok && stream) {
+        int ret;
+        if (infer_via_graph(c, &norm, out, stream, &ret))
+            return ret;
+    }
+    return run_chain(c, &norm, out, stream);
+}
