+extern "C" AJI_EXPORT aji_ctx *aji_create(const aji_create_params *params)
+{
+    if (!params || params->api_version != AJI_API_VERSION)
+        return nullptr;
+
+    /* 3.3.x semantics: backend lives in [global] of animejanai.conf;
+     * direct mode (no conf) is the TRT harness path */
+    std::string backend;
+    const std::string stem = select_backend_stem(params, &backend,
+                                                 params->log, params->log_opaque);
 
     aji_backend be = {};
     std::string err;
-    if (!load_backend(stem, &be, &err)) {
+    if (!load_backend(stem.c_str(), &be, &err)) {
         logf_to(params->log, params->log_opaque, 0,
-                "backend %s (%s): %s", backend.c_str(), stem, err.c_str());
+                "backend %s (%s): %s", backend.c_str(), stem.c_str(), err.c_str());
         return nullptr;
     }
     logf_to(params->log, params->log_opaque, 3,
-            "backend: %s (%s)", backend.c_str(), stem);
+            "backend: %s (%s)", backend.c_str(), stem.c_str());
 
     aji_ctx *inner = be.create(params);
     if (!inner) {
@@ -423,3 +460,278 @@ extern "C" AJI_EXPORT int aji_native_control(
     s->result = AJI_NATIVE_OK;
     return AJI_NATIVE_OK;
 }
+
+/* ------------------------------------------------------------------ *
+ * Prepared-plan exports. The backend prepared symbols are OPTIONAL
+ * (resolved with lib_sym above): a backend that predates them, or one
+ * that does not implement prepared admission at all, is refused here by
+ * name while the legacy ABI-8 and v2 snapshot/control calls keep working.
+ * ------------------------------------------------------------------ */
+
+static void native_envelope(aji_native_snapshot_v2 *s,
+                            uint32_t requested_protocol)
+{
+    const uint32_t size = s->struct_size;
+    memset(s, 0, sizeof(*s));
+    s->struct_size = size;
+    s->requested_protocol_version = requested_protocol;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+}
+
+static bool native_load_named_backend(const char *name, aji_backend *be,
+                                      std::string *err)
+{
+    std::string lower;
+    for (const char *p = name; p && *p; ++p)
+        lower.push_back((char)tolower((unsigned char)*p));
+    const char *stem = nullptr;
+    if (lower == "tensorrt")
+        stem = "aji_trt";
+    else if (lower == "directml")
+        stem = "aji_dml";
+    if (!stem) {
+        *err = std::string("unknown prepared backend '") +
+               (name ? name : "") + "'";
+        return false;
+    }
+    return load_backend(stem, be, err);
+}
+
+extern "C" AJI_EXPORT aji_ctx *aji_native_create_prepared(
+    const aji_create_params *params, const aji_native_prepared_plan_v1 *plan,
+    aji_native_snapshot_v2 *s)
+{
+    if (!s || s->struct_size != sizeof(*s))
+        return nullptr;
+    native_envelope(s, AJI_NATIVE_PROTOCOL_VERSION);
+    s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+    if (!params) {
+        snprintf(s->error, sizeof(s->error), "create_prepared requires create parameters");
+        s->result = AJI_NATIVE_INVALID_ARGUMENT;
+        return nullptr;
+    }
+    if (!plan || plan->struct_size != sizeof(*plan) ||
+        plan->requested_protocol != AJI_NATIVE_PREPARED_PROTOCOL_VERSION) {
+        snprintf(s->error, sizeof(s->error),
+                 "create_prepared requires a prepared-plan v1 structure");
+        s->result = AJI_NATIVE_INVALID_ARGUMENT;
+        return nullptr;
+    }
+
+    aji_backend be = {};
+    std::string err;
+    if (!native_load_named_backend(plan->backend, &be, &err)) {
+        snprintf(s->error, sizeof(s->error), "%s", err.c_str());
+        s->result = AJI_NATIVE_UNSUPPORTED;
+        return nullptr;
+    }
+    if (!be.native_create_prepared) {
+        lib_close(be.lib);
+        snprintf(s->error, sizeof(s->error),
+                 "backend does not implement prepared admission");
+        s->result = AJI_NATIVE_UNSUPPORTED;
+        return nullptr;
+    }
+    aji_ctx *inner = be.native_create_prepared(params, plan, s);
+    if (!inner) {
+        lib_close(be.lib);
+        if (!s->error[0])
+            snprintf(s->error, sizeof(s->error), "prepared admission refused");
+        if (!s->result)
+            s->result = AJI_NATIVE_OPERATION_FAILED;
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        return nullptr;
+    }
+    aji_ctx *c = new aji_ctx{be, inner};
+    /* The wrapper is only useful with the observed snapshot of what was
+       actually loaded: publish the backend's own view, exactly as
+       apply_prepared does, instead of returning the zeroed envelope. A
+       backend that cannot describe the plan it just loaded is refused by
+       name here rather than left reading as a Prepared plan nothing observed. */
+    const int snap = be.native_snapshot(inner, s);
+    s->struct_size = sizeof(*s);
+    s->requested_protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+    if (snap != AJI_NATIVE_OK) {
+        be.destroy(&inner);
+        lib_close(be.lib);
+        delete c;
+        native_envelope(s, AJI_NATIVE_PROTOCOL_VERSION);
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        s->result = (uint32_t)snap;
+        snprintf(s->error, sizeof(s->error),
+                 "prepared snapshot unavailable after load");
+        return nullptr;
+    }
+    s->result = AJI_NATIVE_OK;
+    return c;
+}
+
+extern "C" AJI_EXPORT int aji_native_apply_prepared(
+    aji_ctx *c, const aji_native_prepared_plan_v1 *plan,
+    aji_native_snapshot_v2 *s)
+{
+    if (!s || s->struct_size != sizeof(*s))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    native_envelope(s, AJI_NATIVE_PROTOCOL_VERSION);
+    if (!c) {
+        snprintf(s->error, sizeof(s->error), "native context is absent");
+        s->result = AJI_NATIVE_NO_CONTEXT;
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        return AJI_NATIVE_NO_CONTEXT;
+    }
+    if (!plan || plan->struct_size != sizeof(*plan)) {
+        snprintf(s->error, sizeof(s->error),
+                 "prepared plan is absent or its struct_size does not match");
+        s->result = AJI_NATIVE_INVALID_ARGUMENT;
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+    if (!c->be.native_apply_prepared) {
+        snprintf(s->error, sizeof(s->error),
+                 "backend does not implement prepared admission");
+        s->result = AJI_NATIVE_UNSUPPORTED;
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        return AJI_NATIVE_UNSUPPORTED;
+    }
+    const int rc = c->be.native_apply_prepared(c->inner, plan, s);
+    s->struct_size = sizeof(*s);
+    s->requested_protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+    s->result = (uint32_t)rc;
+    if (rc != AJI_NATIVE_OK) {
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        if (!s->error[0])
+            snprintf(s->error, sizeof(s->error), "prepared admission refused");
+    }
+    return rc;
+}
+
+extern "C" AJI_EXPORT int aji_native_control_on_stream(
+    aji_ctx *c, uint32_t requested_protocol, uint32_t action, uint64_t epoch,
+    uint32_t timeout_ms, void *stream, aji_native_snapshot_v2 *s)
+{
+    if (!s || s->struct_size != sizeof(*s))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    native_envelope(s, requested_protocol);
+    if (requested_protocol != AJI_NATIVE_PROTOCOL_VERSION) {
+        snprintf(s->error, sizeof(s->error),
+                 "protocol mismatch: caller=%u producer=%u",
+                 requested_protocol, AJI_NATIVE_PROTOCOL_VERSION);
+        s->result = AJI_NATIVE_PROTOCOL_MISMATCH;
+        return AJI_NATIVE_PROTOCOL_MISMATCH;
+    }
+    if (action < AJI_NATIVE_CONTROL_DRAIN ||
+        action > AJI_NATIVE_CONTROL_RESUME) {
+        snprintf(s->error, sizeof(s->error),
+                 "unknown native control action: %u", action);
+        s->result = AJI_NATIVE_INVALID_ARGUMENT;
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+    if (!c) {
+        snprintf(s->error, sizeof(s->error), "native context is absent");
+        s->result = AJI_NATIVE_NO_CONTEXT;
+        return AJI_NATIVE_NO_CONTEXT;
+    }
+    if (!c->be.native_control_on_stream) {
+        snprintf(s->error, sizeof(s->error),
+                 "backend does not implement stream-ordered control");
+        s->result = AJI_NATIVE_UNSUPPORTED;
+        s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+        return AJI_NATIVE_UNSUPPORTED;
+    }
+    int rc = c->be.native_control_on_stream(c->inner, action, epoch,
+                                            timeout_ms, stream);
+    const int snapshot_rc = c->be.native_snapshot(c->inner, s);
+    if (rc == AJI_NATIVE_OK && snapshot_rc != AJI_NATIVE_OK)
+        rc = snapshot_rc;
+    if (rc != AJI_NATIVE_OK) {
+        const char *msg = c->be.last_error(c->inner);
+        if (msg && msg[0])
+            snprintf(s->error, sizeof(s->error), "%s", msg);
+        reset_native_refusal(s, requested_protocol, AJI_NATIVE_OPERATION_FAILED);
+        return AJI_NATIVE_OPERATION_FAILED;
+    }
+    s->struct_size = sizeof(*s);
+    s->requested_protocol_version = requested_protocol;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+    s->result = AJI_NATIVE_OK;
+    return AJI_NATIVE_OK;
+}
+
+/* Factory capability query. The producer's own backend symbol is optional:
+   a backend that predates it, or one that does not implement prepared
+   admission at all, is refused here by name while the legacy ABI-8, v2
+   snapshot/control and prepared-plan calls keep working. params carries the
+   caller's already-adopted CUDA context and is passed through unchanged. */
+extern "C" AJI_EXPORT int aji_native_query_factory(
+    const aji_create_params *params, aji_native_factory_capabilities_v1 *out)
+{
+    if (!out || out->struct_size != sizeof(*out))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    const uint32_t size = out->struct_size;
+    const uint32_t requested = out->requested_protocol;
+    memset(out, 0, sizeof(*out));
+    out->struct_size = size;
+    out->requested_protocol = requested;
+    out->protocol_version = AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION;
+    out->native_protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    out->native_schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    out->source_abi = AJI_API_VERSION;
+    out->backend = AJI_NATIVE_FACTORY_BACKEND_NONE;
+
+    if (requested != AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION) {
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.protocol");
+        snprintf(out->reason, sizeof(out->reason),
+                 "factory query protocol mismatch: caller=%u producer=%u",
+                 requested, AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION);
+        out->result = AJI_NATIVE_PROTOCOL_MISMATCH;
+        return AJI_NATIVE_PROTOCOL_MISMATCH;
+    }
+    if (!params || params->api_version != AJI_API_VERSION) {
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.params");
+        snprintf(out->reason, sizeof(out->reason),
+                 "factory query requires create parameters at the current ABI");
+        out->result = AJI_NATIVE_INVALID_ARGUMENT;
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+
+    std::string display;
+    const std::string stem = select_backend_stem(params, &display,
+                                                 params->log, params->log_opaque);
+    aji_backend be = {};
+    std::string err;
+    if (!load_backend(stem.c_str(), &be, &err)) {
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.backend");
+        snprintf(out->reason, sizeof(out->reason), "%s", err.c_str());
+        out->result = AJI_NATIVE_BACKEND_UNAVAILABLE;
+        return AJI_NATIVE_BACKEND_UNAVAILABLE;
+    }
+    if (!be.native_query_factory) {
+        lib_close(be.lib);
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.backend");
+        snprintf(out->reason, sizeof(out->reason),
+                 "backend %s (%s) does not implement the factory capability query",
+                 display.c_str(), stem.c_str());
+        out->result = AJI_NATIVE_UNSUPPORTED;
+        return AJI_NATIVE_UNSUPPORTED;
+    }
+    const int rc = be.native_query_factory(params, out);
+    /* the dispatcher owns the envelope; a backend failure never rewrites it */
+    out->struct_size = size;
+    out->requested_protocol = requested;
+    out->protocol_version = AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION;
+    out->native_protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    out->native_schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    out->source_abi = AJI_API_VERSION;
+    lib_close(be.lib);
+    return rc;
+}
