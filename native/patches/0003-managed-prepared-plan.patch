+// --------------------------------------------------------- managed plan (M8)
+//
+// The prepared exports drive a conf-free chain from the caller's plan: the
+// plan names owned absolute engine/model paths and their expected digests, and
+// every fact is validated against the actual adopted device and the actual
+// engine before anything is deserialized. No cache key, legacy path, trtexec,
+// live build or file deletion is reachable from here.
+
+bool mg_bounded(const char *s, size_t cap, size_t *out_len)
+{
+    if (!s || cap == 0)
+        return false;
+    size_t n = 0;
+    while (n < cap && s[n])
+        ++n;
+    if (n == cap)
+        return false; // not NUL-terminated within its capacity
+    if (out_len)
+        *out_len = n;
+    return true;
+}
+
+bool mg_require_text(const char *s, size_t cap, bool nonempty,
+                     std::string *why, const std::string &field)
+{
+    size_t n = 0;
+    if (!mg_bounded(s, cap, &n)) {
+        if (why) *why = field + " is not NUL-terminated within its capacity";
+        return false;
+    }
+    if (nonempty && n == 0) {
+        if (why) *why = field + " is empty";
+        return false;
+    }
+    return true;
+}
+
+bool mg_lower_hex(const char *s, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        const char ch = s[i];
+        if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')))
+            return false;
+    }
+    return true;
+}
+
+bool mg_sha256_hex(const char *s, std::string *why, const std::string &field)
+{
+    size_t n = 0;
+    if (!mg_bounded(s, AJI_NATIVE_SHA256_CAPACITY, &n) || n != 64 ||
+        !mg_lower_hex(s, n)) {
+        if (why) *why = field + " must be 64 lower-case hex";
+        return false;
+    }
+    return true;
+}
+
+bool mg_absolute_path(const char *s, size_t cap, std::string *why,
+                      const std::string &field)
+{
+    size_t n = 0;
+    if (!mg_bounded(s, cap, &n) || n == 0) {
+        if (why) *why = field + " is empty";
+        return false;
+    }
+    if (!fs::path(s).is_absolute()) {
+        if (why) *why = field + " is not an absolute path";
+        return false;
+    }
+    return true;
+}
+
+char mg_lower(char ch)
+{
+    return (ch >= 'A' && ch <= 'Z') ? (char)(ch - 'A' + 'a') : ch;
+}
+
+bool mg_eq_ci(const char *a, const char *b)
+{
+    if (!a || !b)
+        return false;
+    while (*a && *b) {
+        if (mg_lower(*a) != mg_lower(*b))
+            return false;
+        ++a;
+        ++b;
+    }
+    return *a == 0 && *b == 0;
+}
+
+bool mg_contains_ci(const std::string &hay, const std::string &needle)
+{
+    if (needle.empty() || needle.size() > hay.size())
+        return false;
+    for (size_t i = 0; i + needle.size() <= hay.size(); i++) {
+        size_t j = 0;
+        while (j < needle.size() && mg_lower(hay[i + j]) == mg_lower(needle[j]))
+            ++j;
+        if (j == needle.size())
+            return true;
+    }
+    return false;
+}
+
+bool mg_unresolved_token(const char *s)
+{
+    return mg_eq_ci(s, "auto") || mg_eq_ci(s, "unknown") ||
+           mg_eq_ci(s, "?") || mg_eq_ci(s, "none");
+}
+
+// Centred, rounded down to even: the reference pad for the temporal stage.
+void mg_centred_pad(int content, int geometry, int *pad)
+{
+    *pad = ((geometry - content) / 2) & ~1;
+}
+
+// Display geometry after crop-then-rotate, or nothing for a rotation this
+// build does not model.
+bool mg_display_size(const aji_native_prepared_plan_v1 &p, int *w, int *h)
+{
+    int cw = (int)p.source_coded_width;
+    int ch = (int)p.source_coded_height;
+    if (p.source_crop_width && p.source_crop_height) {
+        cw = (int)p.source_crop_width;
+        ch = (int)p.source_crop_height;
+    }
+    if (cw < 2 || ch < 2)
+        return false;
+    switch (p.source_rotation) {
+    case 0:
+    case 180:
+        *w = cw;
+        *h = ch;
+        return true;
+    case 90:
+    case 270:
+        *w = ch;
+        *h = cw;
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool mg_precision_dtype(const char *precision, uint32_t *dtype)
+{
+    if (mg_eq_ci(precision, "fp16")) { *dtype = AJI_NATIVE_DTYPE_FP16; return true; }
+    if (mg_eq_ci(precision, "fp32")) { *dtype = AJI_NATIVE_DTYPE_FP32; return true; }
+    return false;
+}
+
+bool mg_validate_options(const char *s, std::string *why)
+{
+    size_t n = 0;
+    if (!mg_bounded(s, AJI_NATIVE_BUILD_OPTIONS_CAPACITY, &n)) {
+        if (why) *why = "build_options is not NUL-terminated within its capacity";
+        return false;
+    }
+    size_t i = 0;
+    while (i < n) {
+        while (i < n && (s[i] == ' ' || s[i] == '\t'))
+            ++i;
+        if (i >= n)
+            break;
+        if (s[i] != '-' || i + 1 >= n || s[i + 1] != '-') {
+            if (why) *why = "build_options has a token that is not --name[=value]";
+            return false;
+        }
+        while (i < n && s[i] != ' ' && s[i] != '\t')
+            ++i;
+    }
+    return true;
+}
+
+bool mg_validate_plan(const aji_native_prepared_plan_v1 &p, std::string *why)
+{
+    if (p.struct_size != sizeof(aji_native_prepared_plan_v1)) {
+        if (why) *why = "plan struct_size does not match this producer";
+        return false;
+    }
+    if (p.requested_protocol != AJI_NATIVE_PREPARED_PROTOCOL_VERSION) {
+        if (why) *why = "plan requested_protocol is not prepared-plan v1";
+        return false;
+    }
+    if (p.flags != AJI_NATIVE_PLAN_FLAG_PREPARED_ONLY) {
+        if (why) *why = "plan flags must be exactly PREPARED_ONLY";
+        return false;
+    }
+    if (p.stage_count < 1 || p.stage_count > AJI_NATIVE_MAX_STAGES) {
+        if (why) *why = "plan stage_count is out of range";
+        return false;
+    }
+    if (!mg_require_text(p.requested_plan, sizeof(p.requested_plan), true, why, "requested_plan") ||
+        !mg_require_text(p.recipe_id, sizeof(p.recipe_id), true, why, "recipe_id") ||
+        !mg_require_text(p.backend, sizeof(p.backend), true, why, "backend") ||
+        !mg_require_text(p.device_identity, sizeof(p.device_identity), true, why, "device_identity"))
+        return false;
+    if (p.source_coded_width < 2 || p.source_coded_height < 2) {
+        if (why) *why = "source coded size is not a usable frame";
+        return false;
+    }
+    if (p.source_crop_width || p.source_crop_height) {
+        if (p.source_crop_width < 2 || p.source_crop_height < 2 ||
+            p.source_crop_x + p.source_crop_width > p.source_coded_width ||
+            p.source_crop_y + p.source_crop_height > p.source_coded_height) {
+            if (why) *why = "source crop lies outside the coded frame";
+            return false;
+        }
+    }
+    if (p.source_rotation != 0 && p.source_rotation != 90 &&
+        p.source_rotation != 180 && p.source_rotation != 270) {
+        if (why) *why = "source rotation is not one of 0/90/180/270";
+        return false;
+    }
+    if (p.source_fps_num == 0 || p.source_fps_den == 0) {
+        if (why) *why = "source fps is not a positive rational";
+        return false;
+    }
+    switch (p.source_bit_depth) {
+    case 0: case 8: case 10: case 12: case 14: case 16: break;
+    default:
+        if (why) *why = "source bit depth is not a supported depth";
+        return false;
+    }
+    {
+        const char *tok[4] = {p.source_csp, p.source_matrix, p.source_range,
+                              p.source_siting};
+        const char *name[4] = {"source_csp", "source_matrix", "source_range",
+                               "source_siting"};
+        for (int i = 0; i < 4; i++) {
+            if (!mg_require_text(tok[i], AJI_NATIVE_TEXT_CAPACITY, false, why,
+                                 name[i]))
+                return false;
+            if (tok[i][0] && mg_unresolved_token(tok[i])) {
+                if (why) *why = std::string(name[i]) + " is an unresolved placeholder";
+                return false;
+            }
+        }
+    }
+    if (!mg_require_text(p.decoder_device_uuid, sizeof(p.decoder_device_uuid), true, why, "decoder_device_uuid") ||
+        !mg_require_text(p.compute_device_uuid, sizeof(p.compute_device_uuid), true, why, "compute_device_uuid") ||
+        !mg_require_text(p.adapter_luid, sizeof(p.adapter_luid), false, why, "adapter_luid"))
+        return false;
+    if (p.device_sm_major == 0) {
+        if (why) *why = "device_sm_major is unknown (0)";
+        return false;
+    }
+    if (!mg_require_text(p.build_provider, sizeof(p.build_provider), true, why, "build_provider") ||
+        !mg_require_text(p.build_runtime, sizeof(p.build_runtime), true, why, "build_runtime") ||
+        !mg_require_text(p.build_plugin, sizeof(p.build_plugin), true, why, "build_plugin") ||
+        !mg_require_text(p.build_precision, sizeof(p.build_precision), true, why, "build_precision"))
+        return false;
+    {
+        size_t n = 0;
+        if (!mg_bounded(p.build_core_sha, sizeof(p.build_core_sha), &n) ||
+            (n != 40 && n != 64) || !mg_lower_hex(p.build_core_sha, n)) {
+            if (why) *why = "build_core_sha must be 40 or 64 lower-case hex";
+            return false;
+        }
+    }
+    if (p.build_source_abi == 0) {
+        if (why) *why = "build_source_abi is unknown (0)";
+        return false;
+    }
+    uint32_t precision_dtype = 0;
+    if (!mg_precision_dtype(p.build_precision, &precision_dtype)) {
+        if (why) *why = "build_precision is neither fp16 nor fp32";
+        return false;
+    }
+    if (p.build_tf32 > 1 || p.build_strongly_typed > 1 ||
+        p.build_skip_inference > 1) {
+        if (why) *why = "build boolean facts must be 0 or 1";
+        return false;
+    }
+    if (!mg_validate_options(p.build_options, why))
+        return false;
+
+    int run_w = 0, run_h = 0;
+    if (!mg_display_size(p, &run_w, &run_h)) {
+        if (why) *why = "source geometry does not resolve to a display size";
+        return false;
+    }
+    int temporal_index = -1;
+    for (uint32_t i = 0; i < p.stage_count; i++) {
+        const aji_native_prepared_stage_v1 &st = p.stages[i];
+        const std::string at = "stage " + std::to_string(i);
+        if (st.struct_size != sizeof(aji_native_prepared_stage_v1)) {
+            if (why) *why = at + " struct_size does not match this producer";
+            return false;
+        }
+        if (st.ordinal != i) {
+            if (why) *why = at + " ordinal is not the strictly ascending execution position";
+            return false;
+        }
+        if (st.input_width < 2 || st.input_height < 2 ||
+            st.output_width < 2 || st.output_height < 2 ||
+            (st.input_width & 1) || (st.input_height & 1) ||
+            (st.output_width & 1) || (st.output_height & 1)) {
+            if (why) *why = at + " geometry is not an even frame of at least 2x2";
+            return false;
+        }
+        if (st.input_channels == 0 || st.input_channels > 64 ||
+            st.output_channels == 0 || st.output_channels > 64) {
+            if (why) *why = at + " channel counts are out of range";
+            return false;
+        }
+        if (st.input_dtype != precision_dtype || st.output_dtype != precision_dtype) {
+            if (why) *why = at + " dtype disagrees with the plan build precision";
+            return false;
+        }
+        if (st.input_layout != AJI_NATIVE_LAYOUT_CHW ||
+            st.output_layout != AJI_NATIVE_LAYOUT_CHW) {
+            if (why) *why = at + " layout is not chw";
+            return false;
+        }
+        if (!mg_require_text(st.model_id, sizeof(st.model_id), true, why, at + " model_id") ||
+            !mg_require_text(st.model_content_id, sizeof(st.model_content_id), true, why, at + " model_content_id") ||
+            !mg_require_text(st.build_key, sizeof(st.build_key), true, why, at + " build_key") ||
+            !mg_require_text(st.input_tensor, sizeof(st.input_tensor), false, why, at + " input_tensor") ||
+            !mg_require_text(st.output_tensor, sizeof(st.output_tensor), false, why, at + " output_tensor"))
+            return false;
+        if (!mg_sha256_hex(st.model_sha256, why, at + " model_sha256") ||
+            !mg_sha256_hex(st.engine_sha256, why, at + " engine_sha256"))
+            return false;
+        if (!mg_absolute_path(st.model_path, sizeof(st.model_path), why, at + " model_path") ||
+            !mg_absolute_path(st.engine_path, sizeof(st.engine_path), why, at + " engine_path"))
+            return false;
+
+        if (st.role == AJI_NATIVE_ROLE_SPATIAL) {
+            if (st.order != AJI_NATIVE_ORDER_NONE) {
+                if (why) *why = at + " spatial stage must carry order NONE";
+                return false;
+            }
+            if (st.pad_left || st.pad_top || st.factor_num || st.factor_den ||
+                st.scene_threshold != 0.0) {
+                if (why) *why = at + " spatial stage carries temporal facts";
+                return false;
+            }
+            if (st.content_width != st.input_width ||
+                st.content_height != st.input_height) {
+                if (why) *why = at + " spatial content window is not its input geometry";
+                return false;
+            }
+            // A gap between the running window and this stage's input is a
+            // real resize the executor inserts (Spline36, as the reference
+            // does for a resize-before-upscale); it is not a silent default.
+            run_w = (int)st.output_width;
+            run_h = (int)st.output_height;
+        } else if (st.role == AJI_NATIVE_ROLE_TEMPORAL) {
+            if (temporal_index >= 0) {
+                if (why) *why = at + " is a second temporal stage; this producer admits one RIFE stage";
+                return false;
+            }
+            temporal_index = (int)i;
+            if (st.order != AJI_NATIVE_ORDER_BEFORE_SPATIAL &&
+                st.order != AJI_NATIVE_ORDER_AFTER_SPATIAL) {
+                if (why) *why = at + " temporal stage must carry an explicit order";
+                return false;
+            }
+            if (st.input_channels != 11 || st.output_channels != 3) {
+                if (why) *why = at + " temporal stage must bind an 11-channel RIFE input and 3-channel output";
+                return false;
+            }
+            if (st.input_width != st.output_width ||
+                st.input_height != st.output_height) {
+                if (why) *why = at + " temporal stage must not rescale";
+                return false;
+            }
+            if (st.factor_num == 0 || st.factor_den == 0) {
+                if (why) *why = at + " temporal interpolation factor is not positive";
+                return false;
+            }
+            if (!(st.scene_threshold >= 0.0 && st.scene_threshold <= 1.0)) {
+                if (why) *why = at + " temporal scene threshold is outside [0,1]";
+                return false;
+            }
+            if (st.content_width != (uint32_t)run_w ||
+                st.content_height != (uint32_t)run_h) {
+                if (why) *why = at + " temporal content window does not match the running window";
+                return false;
+            }
+            if (st.content_width > st.input_width ||
+                st.content_height > st.input_height) {
+                if (why) *why = at + " temporal content window exceeds its padded geometry";
+                return false;
+            }
+            int want_l = 0, want_t = 0;
+            mg_centred_pad((int)st.content_width, (int)st.input_width, &want_l);
+            mg_centred_pad((int)st.content_height, (int)st.input_height, &want_t);
+            if (st.pad_left != (uint32_t)want_l || st.pad_top != (uint32_t)want_t) {
+                if (why) *why = at + " temporal padding is not the centred even pad of the content window";
+                return false;
+            }
+        } else {
+            if (why) *why = at + " role is neither spatial nor temporal";
+            return false;
+        }
+    }
+    if (temporal_index >= 0) {
+        const uint32_t ti = (uint32_t)temporal_index;
+        if (p.stages[ti].order == AJI_NATIVE_ORDER_BEFORE_SPATIAL) {
+            if (ti != 0) {
+                if (why) *why = "temporal BEFORE_SPATIAL must precede every spatial stage";
+                return false;
+            }
+        } else if (ti + 1 != p.stage_count) {
+            if (why) *why = "temporal AFTER_SPATIAL must follow every spatial stage";
+            return false;
+        }
+    }
+    if (run_w < 2 || run_h < 2 || (run_w & 1) || (run_h & 1)) {
+        if (why) *why = "chain output geometry is not an even frame of at least 2x2";
+        return false;
+    }
+    return true;
+}
+
+// Actual adopted device identity: computed, never copied from the caller.
+bool mg_observe_device(aji_ctx *c, std::string *why, std::string *uuid_hex,
+                       std::string *identity, int *sm_major, int *sm_minor)
+{
+    CtxGuard guard(c->cu_ctx);
+    if (!guard.ok) {
+        *why = "cuCtxPushCurrent failed";
+        return false;
+    }
+    CUdevice dev;
+    if (cuCtxGetDevice(&dev) != CUDA_SUCCESS) {
+        *why = "cuCtxGetDevice failed";
+        return false;
+    }
+    CUuuid uuid;
+    if (cuDeviceGetUuid(&uuid, dev) != CUDA_SUCCESS) {
+        *why = "cuDeviceGetUuid failed";
+        return false;
+    }
+    char hex[33];
+    static const char digits[] = "0123456789abcdef";
+    for (int i = 0; i < 16; i++) {
+        hex[i * 2] = digits[((unsigned char)uuid.bytes[i]) >> 4];
+        hex[i * 2 + 1] = digits[((unsigned char)uuid.bytes[i]) & 0x0f];
+    }
+    hex[32] = 0;
+    int major = 0, minor = 0;
+    cuDeviceGetAttribute(&major, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR, dev);
+    cuDeviceGetAttribute(&minor, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR, dev);
+    *uuid_hex = hex;
+    *identity = std::string("CUDA-UUID:") + hex;
+    *sm_major = major;
+    *sm_minor = minor;
+    return true;
+}
+
+// Plan identity vs the actual adopted device and the actual loaded runtime.
+bool mg_validate_identity(aji_ctx *c, const aji_native_prepared_plan_v1 &p,
+                          std::string *why)
+{
+    if (!mg_eq_ci(p.backend, "TensorRT")) {
+        *why = std::string("plan backend '") + p.backend + "' is not TensorRT";
+        return false;
+    }
+    if (!mg_eq_ci(p.build_provider, "TensorRT")) {
+        *why = std::string("build_provider '") + p.build_provider + "' is not TensorRT";
+        return false;
+    }
+    const std::string actual_runtime = trt_version_token();
+    if (std::string(p.build_runtime) != actual_runtime) {
+        *why = "build_runtime '" + std::string(p.build_runtime) +
+               "' does not match the loaded TensorRT " + actual_runtime;
+        return false;
+    }
+    std::string uuid_hex, identity;
+    int sm_major = 0, sm_minor = 0;
+    if (!mg_observe_device(c, why, &uuid_hex, &identity, &sm_major, &sm_minor))
+        return false;
+    if (!mg_contains_ci(p.device_identity, uuid_hex)) {
+        *why = "device_identity does not name the adopted compute device";
+        return false;
+    }
+    if (!mg_contains_ci(p.compute_device_uuid, uuid_hex)) {
+        *why = "compute_device_uuid does not name the adopted compute device";
+        return false;
+    }
+    if ((int)p.device_sm_major != sm_major || (int)p.device_sm_minor != sm_minor) {
+        *why = "device SM does not match the adopted compute device";
+        return false;
+    }
+    return true;
+}
+
+// Hash the owned engine/model files and compare the digests BEFORE any
+// deserialize; then validate the engine's real tensor names, dtypes and
+// shapes against the declared stage. The file is never deleted or rewritten.
+bool mg_load_engine(aji_ctx *c, const aji_native_prepared_stage_v1 &st,
+                    ModelEngine *me, std::string *why)
+{
+    std::vector<char> blob;
+    if (!read_file_bytes(st.engine_path, &blob)) {
+        *why = std::string("cannot read engine file ") + st.engine_path;
+        return false;
+    }
+    std::string sha;
+    if (!native_sha256(blob.data(), blob.size(), &sha) || sha != st.engine_sha256) {
+        *why = std::string("engine digest mismatch for ") + st.engine_path +
+               " (expected " + st.engine_sha256 + ", actual " + sha + ")";
+        return false;   // refused before deserialize; the file is untouched
+    }
+    std::vector<char> model;
+    if (!read_file_bytes(st.model_path, &model)) {
+        *why = std::string("cannot read model file ") + st.model_path;
+        return false;
+    }
+    std::string msha;
+    if (!native_sha256(model.data(), model.size(), &msha) || msha != st.model_sha256) {
+        *why = std::string("model digest mismatch for ") + st.model_path +
+               " (expected " + st.model_sha256 + ", actual " + msha + ")";
+        return false;
+    }
+    me->engine.reset(c->runtime->deserializeCudaEngine(blob.data(), blob.size()));
+    if (!me->engine) {
+        *why = std::string("engine deserialization failed: ") + st.engine_path;
+        return false;
+    }
+
+    const char *in_name = nullptr, *out_name = nullptr;
+    int inputs = 0, outputs = 0;
+    for (int i = 0; i < me->engine->getNbIOTensors(); i++) {
+        const char *name = me->engine->getIOTensorName(i);
+        if (me->engine->getTensorIOMode(name) == nvinfer1::TensorIOMode::kINPUT) {
+            in_name = name;
+            ++inputs;
+        } else {
+            out_name = name;
+            ++outputs;
+        }
+    }
+    if (inputs != 1 || outputs != 1) {
+        *why = "engine must expose exactly one input and one output tensor";
+        return false;
+    }
+    if (st.input_tensor[0] && strcmp(st.input_tensor, in_name) != 0) {
+        *why = std::string("engine input tensor is '") + in_name +
+               "', not the declared '" + st.input_tensor + "'";
+        return false;
+    }
+    if (st.output_tensor[0] && strcmp(st.output_tensor, out_name) != 0) {
+        *why = std::string("engine output tensor is '") + out_name +
+               "', not the declared '" + st.output_tensor + "'";
+        return false;
+    }
+    me->in_name = in_name;
+    me->out_name = out_name;
+
+    auto dtype_of = [](nvinfer1::DataType t) -> uint32_t {
+        if (t == nvinfer1::DataType::kHALF) return AJI_NATIVE_DTYPE_FP16;
+        if (t == nvinfer1::DataType::kFLOAT) return AJI_NATIVE_DTYPE_FP32;
+        return 0;
+    };
+    if (dtype_of(me->engine->getTensorDataType(in_name)) != st.input_dtype) {
+        *why = "engine input dtype does not match the declared input_dtype";
+        return false;
+    }
+    if (dtype_of(me->engine->getTensorDataType(out_name)) != st.output_dtype) {
+        *why = "engine output dtype does not match the declared output_dtype";
+        return false;
+    }
+
+    me->exec.reset(me->engine->createExecutionContext());
+    if (!me->exec) {
+        *why = "createExecutionContext failed";
+        return false;
+    }
+    if (!me->exec->setInputShape(in_name,
+                                 nvinfer1::Dims4{1, (int64_t)st.input_channels,
+                                                 (int64_t)st.input_height,
+                                                 (int64_t)st.input_width})) {
+        *why = std::string("engine rejects input 1x") +
+               std::to_string(st.input_channels) + "x" +
+               std::to_string(st.input_height) + "x" +
+               std::to_string(st.input_width);
+        return false;
+    }
+    nvinfer1::Dims id = me->exec->getTensorShape(in_name);
+    if (id.nbDims != 4 || id.d[0] != 1 ||
+        (uint32_t)id.d[1] != st.input_channels ||
+        (uint32_t)id.d[2] != st.input_height ||
+        (uint32_t)id.d[3] != st.input_width) {
+        *why = "engine input shape is not the declared 1xCxHxW";
+        return false;
+    }
+    nvinfer1::Dims od = me->exec->getTensorShape(out_name);
+    if (od.nbDims != 4 || od.d[0] != 1 ||
+        (uint32_t)od.d[1] != st.output_channels ||
+        (uint32_t)od.d[2] != st.output_height ||
+        (uint32_t)od.d[3] != st.output_width) {
+        *why = "engine output shape is not the declared 1xCxHxW";
+        return false;
+    }
+    me->in_w = (int)st.input_width;
+    me->in_h = (int)st.input_height;
+    me->out_w = (int)st.output_width;
+    me->out_h = (int)st.output_height;
+    me->engine_sha256 = sha;
+    me->model_sha256 = msha;
+    return true;
+}
+
+// Device resources built for one plan; owns them until commit, so a refusal
+// leaves the previously effective plan and its resources untouched.
+struct ManagedBuild {
+    std::vector<ModelEngine> engines;
+    std::vector<Step> steps;
+    void *buf[2] = {nullptr, nullptr};
+    size_t buf_bytes = 0;
+    int in_w = 0, in_h = 0, out_w = 0, out_h = 0;
+
+    bool has_rife = false;
+    bool rife_before = false;
+    int rw = 0, rh = 0, pw = 0, ph = 0, pad_l = 0, pad_t = 0;
+    int fnum = 1, fden = 1;
+    double scd_threshold = 0.0;
+    ModelEngine rife_engine;
+    void *rife_in = nullptr, *rife_out = nullptr, *rife_scd = nullptr;
+    void *src_scratch[2] = {nullptr, nullptr};
+    size_t src_scratch_bytes = 0;
+
+    void release_plans()
+    {
+        for (Step &s : steps) {
+            aji_plan_destroy(s.plan);
+            s.plan = nullptr;
+        }
+        steps.clear();
+    }
+    void release_device()
+    {
+        release_plans();
+        engines.clear();
+        for (void *&b : buf) {
+            if (b) cudaFree(b);
+            b = nullptr;
+        }
+        buf_bytes = 0;
+        if (rife_in) { cudaFree(rife_in); rife_in = nullptr; }
+        if (rife_out) { cudaFree(rife_out); rife_out = nullptr; }
+        if (rife_scd) { cudaFree(rife_scd); rife_scd = nullptr; }
+        for (void *&b : src_scratch) {
+            if (b) cudaFree(b);
+            b = nullptr;
+        }
+        src_scratch_bytes = 0;
+        rife_engine.exec.reset();
+        rife_engine.engine.reset();
+    }
+    ~ManagedBuild() { release_device(); }
+};
+
+// Release every device resource of the current effective plan (managed or
+// conf) while keeping the managed plan of record so resume can revalidate it.
+void managed_teardown_device(aji_ctx *c)
+{
+    c->engines.clear();
+    for (Step &st : c->steps)
+        aji_plan_destroy(st.plan);
+    c->steps.clear();
+    aji_plan_destroy(c->pre_plan);
+    aji_plan_destroy(c->post_plan);
+    c->pre_plan = c->post_plan = nullptr;
+    memset(c->pre_key, 0, sizeof(c->pre_key));
+    memset(c->post_key, 0, sizeof(c->post_key));
+    aji_plan_destroy(c->pre_resize_plan);
+    aji_plan_destroy(c->pr_pre_plan);
+    aji_plan_destroy(c->pr_post_plan);
+    c->pre_resize_plan = c->pr_pre_plan = c->pr_post_plan = nullptr;
+    c->has_pre_resize = false;
+    c->pre_src_w = c->pre_src_h = 0;
+    c->work_w = c->work_h = 0;
+    rife_teardown(c);
+    if (c->graph_exec) {
+        cudaGraphExecDestroy(c->graph_exec);
+        c->graph_exec = nullptr;
+    }
+    c->graph_ok = true;
+    for (void *&b : c->buf) {
+        if (b) cudaFree(b);
+        b = nullptr;
+    }
+    c->buf_bytes = 0;
+    if (c->stage_in) { cudaFree(c->stage_in); c->stage_in = nullptr; c->stage_in_bytes = 0; }
+    if (c->stage_out) { cudaFree(c->stage_out); c->stage_out = nullptr; c->stage_out_bytes = 0; }
+    for (void *&b : c->src_scratch) {
+        if (b) cudaFree(b);
+        b = nullptr;
+    }
+    c->src_scratch_bytes = 0;
+    c->active = false;
+}
+
+// Validate and load one whole plan, then commit it transactionally.
+int managed_apply(aji_ctx *c, const aji_native_prepared_plan_v1 *plan,
+                  std::string *why)
+{
+    if (!plan) {
+        *why = "plan is absent";
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+    if (!mg_validate_plan(*plan, why))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    if (!mg_validate_identity(c, *plan, why))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+
+    CtxGuard guard(c->cu_ctx);
+    if (!guard.ok) {
+        *why = "cuCtxPushCurrent failed";
+        return AJI_NATIVE_OPERATION_FAILED;
+    }
+
+    ManagedBuild mb;
+    if (!mg_display_size(*plan, &mb.in_w, &mb.in_h)) {
+        *why = "source geometry does not resolve to a display size";
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+    const int coded_w = (int)plan->source_coded_width;
+    const int coded_h = (int)plan->source_coded_height;
+    int crop_x = 0, crop_y = 0, crop_w = coded_w, crop_h = coded_h;
+    if (plan->source_crop_width && plan->source_crop_height) {
+        crop_x = (int)plan->source_crop_x;
+        crop_y = (int)plan->source_crop_y;
+        crop_w = (int)plan->source_crop_width;
+        crop_h = (int)plan->source_crop_height;
+    }
+    const int rotation = (int)plan->source_rotation;
+    const bool transform = !(crop_x == 0 && crop_y == 0 && crop_w == coded_w &&
+                             crop_h == coded_h && rotation == 0);
+    int run_w = mb.in_w, run_h = mb.in_h;
+    size_t max_bytes = (size_t)3 * run_w * run_h * 2;
+    int temporal_index = -1;
+
+    for (uint32_t i = 0; i < plan->stage_count; i++) {
+        const aji_native_prepared_stage_v1 &st = plan->stages[i];
+        if (st.role == AJI_NATIVE_ROLE_TEMPORAL) {
+            temporal_index = (int)i;
+            continue;
+        }
+        if (run_w != (int)st.input_width || run_h != (int)st.input_height) {
+            Step rs{Step::RESIZE, (int)st.input_width, (int)st.input_height, -1};
+            rs.plan = aji_resize_plan_create(run_w, run_h, (int)st.input_width,
+                                             (int)st.input_height);
+            if (!rs.plan) {
+                *why = "resize plan allocation failed";
+                return AJI_NATIVE_OPERATION_FAILED;
+            }
+            mb.steps.push_back(rs);
+            run_w = (int)st.input_width;
+            run_h = (int)st.input_height;
+        }
+        ModelEngine me;
+        if (!mg_load_engine(c, st, &me, why))
+            return AJI_NATIVE_OPERATION_FAILED;
+        run_w = me.out_w;
+        run_h = me.out_h;
+        mb.steps.push_back(Step{Step::MODEL, run_w, run_h, (int)mb.engines.size()});
+        mb.engines.push_back(std::move(me));
+        max_bytes = std::max(max_bytes, (size_t)3 * (size_t)run_w * run_h * 2);
+    }
+    mb.out_w = run_w;
+    mb.out_h = run_h;
+
+    if (temporal_index >= 0) {
+        const aji_native_prepared_stage_v1 &tst = plan->stages[temporal_index];
+        mb.has_rife = true;
+        mb.rife_before = tst.order == AJI_NATIVE_ORDER_BEFORE_SPATIAL;
+        mb.rw = (int)tst.content_width;
+        mb.rh = (int)tst.content_height;
+        mb.pw = (int)tst.input_width;
+        mb.ph = (int)tst.input_height;
+        mb.pad_l = (int)tst.pad_left;
+        mb.pad_t = (int)tst.pad_top;
+        mb.fnum = (int)tst.factor_num;
+        mb.fden = (int)tst.factor_den;
+        mb.scd_threshold = tst.scene_threshold;
+        if (!mg_load_engine(c, tst, &mb.rife_engine, why))
+            return AJI_NATIVE_OPERATION_FAILED;
+        const size_t plane = (size_t)mb.pw * (size_t)mb.ph;
+        if (cudaMalloc(&mb.rife_in, plane * 11 * 2) != cudaSuccess ||
+            cudaMalloc(&mb.rife_out, plane * 3 * 2) != cudaSuccess ||
+            cudaMalloc(&mb.rife_scd, sizeof(float)) != cudaSuccess) {
+            *why = "RIFE tensor allocation failed";
+            return AJI_NATIVE_OPERATION_FAILED;
+        }
+        char *t = (char *)mb.rife_in;
+        aji_rife_fill_consts(t + plane * 7 * 2, t + plane * 8 * 2,
+                             t + plane * 9 * 2, t + plane * 10 * 2,
+                             mb.pw, mb.ph, nullptr);
+        cudaDeviceSynchronize();
+    }
+
+    if (max_bytes) {
+        if (cudaMalloc(&mb.buf[0], max_bytes) != cudaSuccess ||
+            cudaMalloc(&mb.buf[1], max_bytes) != cudaSuccess) {
+            *why = "chain buffer allocation failed";
+            return AJI_NATIVE_OPERATION_FAILED;
+        }
+        mb.buf_bytes = max_bytes;
+    }
+
+    // Scratch display-size YUV frames (one for aji_infer, two for a RIFE pair),
+    // sized for the widest format the transform may see.
+    if (transform) {
+        const size_t bytes = (size_t)3 * (size_t)mb.in_w * (size_t)mb.in_h * 2;
+        if (cudaMalloc(&mb.src_scratch[0], bytes) != cudaSuccess ||
+            cudaMalloc(&mb.src_scratch[1], bytes) != cudaSuccess) {
+            *why = "source transform scratch allocation failed";
+            return AJI_NATIVE_OPERATION_FAILED;
+        }
+        mb.src_scratch_bytes = bytes;
+    }
+
+    // Commit: only now is the previous effective plan torn down.
+    managed_teardown_device(c);
+    c->engines = std::move(mb.engines);
+    c->steps = std::move(mb.steps);
+    c->buf[0] = mb.buf[0];
+    c->buf[1] = mb.buf[1];
+    c->buf_bytes = mb.buf_bytes;
+    mb.buf[0] = mb.buf[1] = nullptr;
+    mb.buf_bytes = 0;
+    c->rife = {};
+    c->rife.enabled = mb.has_rife;
+    c->rife.before_upscale = mb.rife_before;
+    c->rife.num = mb.fnum;
+    c->rife.den = mb.fden;
+    c->rife.scd_threshold = mb.scd_threshold;
+    c->rife.w = mb.rw;
+    c->rife.h = mb.rh;
+    c->rife.pw = mb.pw;
+    c->rife.ph = mb.ph;
+    c->rife.pad_l = mb.pad_l;
+    c->rife.pad_t = mb.pad_t;
+    c->rife.engine = std::move(mb.rife_engine);
+    c->rife.in_tensor = mb.rife_in;
+    c->rife.out_tensor = mb.rife_out;
+    c->rife.scd = (float *)mb.rife_scd;
+    mb.rife_in = mb.rife_out = mb.rife_scd = nullptr;
+
+    c->managed = true;
+    c->managed_ready = true;
+    c->managed_plan = *plan;
+    c->managed_stage_count = plan->stage_count;
+    snprintf(c->managed_requested_plan, sizeof(c->managed_requested_plan), "%s",
+             plan->requested_plan);
+    memset(c->managed_build_keys, 0, sizeof(c->managed_build_keys));
+    for (uint32_t i = 0; i < plan->stage_count && i < AJI_NATIVE_MAX_STAGES; i++)
+        snprintf(c->managed_build_keys[i], AJI_NATIVE_BUILD_KEY_CAPACITY, "%s",
+                 plan->stages[i].build_key);
+
+    c->src_scratch[0] = mb.src_scratch[0];
+    c->src_scratch[1] = mb.src_scratch[1];
+    c->src_scratch_bytes = mb.src_scratch_bytes;
+    mb.src_scratch[0] = mb.src_scratch[1] = nullptr;
+    mb.src_scratch_bytes = 0;
+    c->has_source_transform = transform;
+    c->managed_coded_w = coded_w;
+    c->managed_coded_h = coded_h;
+    c->managed_display_w = mb.in_w;
+    c->managed_display_h = mb.in_h;
+    c->managed_crop_x = crop_x;
+    c->managed_crop_y = crop_y;
+    c->managed_crop_w = crop_w;
+    c->managed_crop_h = crop_h;
+    c->managed_rotation = rotation;
+
+    c->in_w = mb.in_w;
+    c->in_h = mb.in_h;
+    c->out_w = mb.out_w;
+    c->out_h = mb.out_h;
+    c->active = true;
+    c->native_suspended = false;
+    c->native_output_observed = false;
+    c->native_epoch = plan->epoch;
+    c->prepared_only = true;
+    ++c->native_revision;
+    return AJI_NATIVE_OK;
+}
+
+// Configure the stream geometry for an admitted plan: the caller's dims must
+// be the plan's source display size and cadence, nothing is built or loaded.
+int managed_configure(aji_ctx *c, int w, int h, double fps, int *out_w,
+                      int *out_h)
+{
+    const aji_native_prepared_plan_v1 &p = c->managed_plan;
+    if (!c->managed_ready) {
+        c->set_error("prepared plan is not loaded");
+        return AJI_ERR;
+    }
+    int dw = 0, dh = 0;
+    if (!mg_display_size(p, &dw, &dh)) {
+        c->set_error("prepared source geometry does not resolve");
+        return AJI_ERR_SHAPE;
+    }
+    if (w != dw || h != dh) {
+        c->set_error("configure %dx%d does not match prepared source %dx%d",
+                     w, h, dw, dh);
+        return AJI_ERR_SHAPE;
+    }
+    const double plan_fps = (double)p.source_fps_num / (double)p.source_fps_den;
+    if (!(fps > 0.0)) {
+        c->set_error("configure fps is not positive");
+        return AJI_ERR_SHAPE;
+    }
+    const double diff = fps > plan_fps ? fps - plan_fps : plan_fps - fps;
+    if (plan_fps > 0.0 && diff > plan_fps * 0.01) {
+        c->set_error("configure fps %.6f does not match prepared cadence %.6f",
+                     fps, plan_fps);
+        return AJI_ERR_SHAPE;
+    }
+    if (out_w) *out_w = c->out_w;
+    if (out_h) *out_h = c->out_h;
+    return 1;
+}
+
+void mg_fill_refusal(aji_ctx *c, aji_native_snapshot_v2 *s, int result,
+                     const char *reason)
+{
+    if (!s)
+        return;
+    const uint32_t size = s->struct_size;
+    memset(s, 0, sizeof(*s));
+    s->struct_size = size ? size : (uint32_t)sizeof(*s);
+    s->requested_protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+    s->result = (uint32_t)result;
+    s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+    s->backend = 1;
+    snprintf(s->provider, sizeof(s->provider), "%s", "TensorRT");
+    snprintf(s->error, sizeof(s->error), "%s",
+             reason && reason[0] ? reason : "prepared admission refused");
+    if (c) {
+        s->revision = c->native_revision;
+        s->epoch = c->native_epoch;
+    }
+}
