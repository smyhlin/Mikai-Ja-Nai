+/* Factory capability query (query protocol v1). The answer is observed, not
+   declared: the caller's borrowed CUDA context is adopted (this call never
+   creates one), its actual device identity is read, and the real TensorRT
+   runtime factory is initialized and destroyed. No engine, model, network,
+   inference, build or cache path is touched, and the call holds no state, so
+   an unloadable backend cannot be reported ready from a symbol, a
+   preference, a filename or a manifest. */
+extern "C" AJI_EXPORT int aji_native_backend_query_factory(
+    const aji_create_params *params, aji_native_factory_capabilities_v1 *out)
+{
+    if (!out)
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    out->role_bits = 0;
+
+    if (!params || params->api_version != AJI_API_VERSION) {
+        out->result = AJI_NATIVE_INVALID_ARGUMENT;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.params");
+        snprintf(out->reason, sizeof(out->reason),
+                 "factory query requires aji_create_params at the current ABI");
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+    if (!params->cuda_context) {
+        out->result = AJI_NATIVE_NO_CONTEXT;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.context");
+        snprintf(out->reason, sizeof(out->reason),
+                 "no adopted CUDA context was supplied; the query never creates one");
+        return AJI_NATIVE_NO_CONTEXT;
+    }
+
+    CtxGuard guard((CUcontext)params->cuda_context);
+    if (!guard.ok) {
+        out->result = AJI_NATIVE_NO_CONTEXT;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.context");
+        snprintf(out->reason, sizeof(out->reason),
+                 "cuCtxPushCurrent failed for the supplied context");
+        return AJI_NATIVE_NO_CONTEXT;
+    }
+    CUdevice dev = 0;
+    if (cuCtxGetDevice(&dev) != CUDA_SUCCESS) {
+        out->result = AJI_NATIVE_BACKEND_UNAVAILABLE;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.device");
+        snprintf(out->reason, sizeof(out->reason),
+                 "cuCtxGetDevice failed on the adopted context");
+        return AJI_NATIVE_BACKEND_UNAVAILABLE;
+    }
+    CUuuid uuid;
+    if (cuDeviceGetUuid(&uuid, dev) != CUDA_SUCCESS) {
+        out->result = AJI_NATIVE_BACKEND_UNAVAILABLE;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.device");
+        snprintf(out->reason, sizeof(out->reason),
+                 "cuDeviceGetUuid failed on the adopted device");
+        return AJI_NATIVE_BACKEND_UNAVAILABLE;
+    }
+    int major = 0, minor = 0;
+    cuDeviceGetAttribute(&major, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR, dev);
+    cuDeviceGetAttribute(&minor, CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR, dev);
+    if (major < 1 || major > 32 || minor < 0 || minor > 99) {
+        out->result = AJI_NATIVE_BACKEND_UNAVAILABLE;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.device");
+        snprintf(out->reason, sizeof(out->reason),
+                 "the adopted device reported no usable compute capability");
+        return AJI_NATIVE_BACKEND_UNAVAILABLE;
+    }
+
+    Logger logger;
+    logger.fn = params->log;
+    logger.opaque = params->log_opaque;
+    std::unique_ptr<nvinfer1::IRuntime> runtime(
+        nvinfer1::createInferRuntime(logger));
+    if (!runtime) {
+        out->result = AJI_NATIVE_BACKEND_UNAVAILABLE;
+        snprintf(out->reason_key, sizeof(out->reason_key), "native.factory.runtime");
+        snprintf(out->reason, sizeof(out->reason),
+                 "createInferRuntime failed on the adopted context");
+        return AJI_NATIVE_BACKEND_UNAVAILABLE;
+    }
+
+    /* The factory is genuinely usable for this adopted device: publish the
+       observation. Nothing below is filled on any earlier refusal. */
+    out->backend = AJI_NATIVE_FACTORY_BACKEND_TENSORRT;
+    snprintf(out->provider, sizeof(out->provider), "%s", "TensorRT");
+    out->sm_major = (uint32_t)major;
+    out->sm_minor = (uint32_t)minor;
+    {
+        int pos = 0;
+        for (int i = 0; i < 16 && pos < (int)sizeof(out->device_identity) - 2; ++i)
+            pos += snprintf(out->device_identity + pos,
+                            sizeof(out->device_identity) - (size_t)pos,
+                            "%02x", (unsigned char)uuid.bytes[i]);
+    }
+    const std::string runtime_token = trt_version_token();
+    snprintf(out->runtime_version, sizeof(out->runtime_version), "%s",
+             runtime_token.c_str());
+    out->role_bits = AJI_NATIVE_FACTORY_ROLE_SPATIAL |
+                     AJI_NATIVE_FACTORY_ROLE_RIFE;
+    out->result = AJI_NATIVE_OK;
+    return AJI_NATIVE_OK;
+}
