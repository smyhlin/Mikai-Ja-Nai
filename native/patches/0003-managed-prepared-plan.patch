@@ -53,6 +53,21 @@ struct aji_backend {
     void (*destroy)(aji_ctx **);
     int (*native_snapshot)(aji_ctx *, aji_native_snapshot_v2 *);
     int (*native_control)(aji_ctx *, uint32_t, uint64_t, uint32_t);
+    /* prepared-plan exports are optional: a backend built before them simply
+       leaves these null and the dispatcher refuses the prepared calls by name
+       instead of failing the whole backend load */
+    aji_ctx *(*native_create_prepared)(const aji_create_params *,
+                                       const aji_native_prepared_plan_v1 *,
+                                       aji_native_snapshot_v2 *);
+    int (*native_apply_prepared)(aji_ctx *,
+                                 const aji_native_prepared_plan_v1 *,
+                                 aji_native_snapshot_v2 *);
+    int (*native_control_on_stream)(aji_ctx *, uint32_t, uint64_t, uint32_t,
+                                    void *);
+    /* factory capability query is optional too: a backend without it is
+       refused by name and keeps serving the legacy and prepared calls */
+    int (*native_query_factory)(const aji_create_params *,
+                                aji_native_factory_capabilities_v1 *);
 };
 
 /* The dispatcher's aji_ctx wraps the backend's. */
@@ -176,16 +191,24 @@ static bool load_backend(const char *stem, aji_backend *be,
     SYM(native_snapshot, "aji_native_backend_snapshot");
     SYM(native_control, "aji_native_backend_control");
 #undef SYM
+    *(void **)&be->native_create_prepared =
+        lib_sym(be->lib, "aji_native_backend_create_prepared");
+    *(void **)&be->native_apply_prepared =
+        lib_sym(be->lib, "aji_native_backend_apply_prepared");
+    *(void **)&be->native_control_on_stream =
+        lib_sym(be->lib, "aji_native_backend_control_on_stream");
+    *(void **)&be->native_query_factory =
+        lib_sym(be->lib, "aji_native_backend_query_factory");
     return true;
 }
 
-extern "C" AJI_EXPORT aji_ctx *aji_create(const aji_create_params *params)
