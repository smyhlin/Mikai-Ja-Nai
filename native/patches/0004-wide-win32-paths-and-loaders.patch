+#ifdef _WIN32
+/* Opens the conf through a strict UTF-8 -> UTF-16 conversion and the wide
+ * CRT, instead of std::ifstream's const char * overload.
+ *
+ * That overload takes the path in the *process ANSI code page*, so a conf under
+ * a non-ASCII directory was either not found or, worse, found at a path that
+ * is not the one the caller named. MB_ERR_INVALID_CHARS makes an unconvertible
+ * name fail here rather than be read as U+FFFD.
+ */
+static std::ifstream open_conf_stream(const char *path)
+{
+    if (!path || !path[0])
+        return std::ifstream();
+    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);
+    if (n <= 0)
+        return std::ifstream();
+    std::wstring wpath((size_t)n - 1, L'\0');
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, &wpath[0], n) <= 0)
+        return std::ifstream();
+    return std::ifstream(wpath.c_str());
+}
+#endif
