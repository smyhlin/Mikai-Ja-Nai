+#ifdef _WIN32
+/* Strict UTF-8 -> UTF-16 for a path this DLL is about to open or load.
+ *
+ * aji_dml's `widen` uses MultiByteToWideChar without MB_ERR_INVALID_CHARS,
+ * which replaces an unconvertible byte sequence with U+FFFD instead of
+ * failing: the caller would then be handed a path naming a *different* file
+ * than the one that was asked for. Every conversion here refuses instead, so
+ * a malformed name is a load that fails and names itself.
+ */
+static std::wstring widen_utf8_strict(const std::string &s)
+{
+    if (s.empty())
+        return std::wstring();
+    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, s.c_str(), -1, NULL, 0);
+    if (n <= 0)
+        return std::wstring();
+    std::wstring w((size_t)n - 1, L'\0');
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, s.c_str(), -1, &w[0], n) <= 0)
+        return std::wstring();
+    return w;
+}
+#endif
