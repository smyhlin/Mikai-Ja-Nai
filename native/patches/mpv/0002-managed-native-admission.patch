+// a version can never inject members into or truncate the snapshot document.
+static void status_json_escape(struct mp_filter *vf, bstr *s, const char *text)
+{
+    for (const unsigned char *c = (const unsigned char *)text; *c; c++) {
+        switch (*c) {
+        case '"':
