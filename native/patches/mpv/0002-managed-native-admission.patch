+// ---- Native status publication -------------------------------------------
+// The Qt consumer (mplayer::native::NativeStatus) reads one flat string map
+// with exactly `schema`, `protocol`, `revision` and `snapshot`; the snapshot is
+// a compact UTF-8 JSON document whose inner scalars keep their real JSON types.
+// This filter is the producer: the pure Probe passthrough reports only observed
+// source/decoder-device facts, never a plan, counters or Active. The document
+// is cached and rebuilt only when a published fact or the lifecycle changes.
+
+// The filter's monotonic change counter: unchanged state keeps the revision.
+static void status_touch(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    p->status_revision++;
+    p->status_dirty = true;
+}
+
+// Every epoch comes from one process-wide sequence, so a filter recreation (a
+// fresh priv starting from zero) is still a strictly newer lifecycle than the
+// one it replaced, and a consumer that missed the gap never reads the new
+// filter as a stale read of the old one.
+static atomic_int_least64_t status_epoch_seed;
+
+static int64_t status_next_epoch(void)
+{
+    return (int64_t)atomic_fetch_add(&status_epoch_seed, 1);
+}
+
+// A new lifecycle: seek/reset, source or device reinit, or filter recreation.
+// The epoch advances together with the revision so the consumer can tell a
+// restart from a stale read even when the facts themselves did not change.
+static void status_begin_epoch(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    p->status_epoch = status_next_epoch();
+    status_touch(vf);
+}
+
+// Drop the observed device identity: the context it was read from is gone.
+static void clear_device_identity(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    const bool had = p->device_known || p->decoder_uuid[0] ||
+                     p->adapter_luid[0] || p->sm_major || p->sm_minor ||
+                     p->compute_known || p->compute_uuid[0] || p->factory_queried;
+    p->device_known = false;
+    p->decoder_uuid[0] = '\0';
+    p->adapter_luid[0] = '\0';
+    p->sm_major = p->sm_minor = 0;
+    p->compute_known = false;
+    p->compute_uuid[0] = '\0';
+    p->compute_uuid_hex[0] = '\0';
+    // The factory observation belongs to the context being dropped here; a
+    // different device/context must be re-queried, not answered from a stale
+    // reply that could enable a different core.
+    p->factory_queried = false;
+    p->factory_observed = false;
+    memset(&p->factory, 0, sizeof(p->factory));
+    if (had)
+        status_touch(vf);
+}
+
+// The actual decoder device, read from the CUDA context the incoming
+// AVHWFramesContext lives on. Pushes that context, queries the current CUdevice
+// and its identity, and pops on every successful push. The optional UUID entry
+// points are guarded; the SM is reported when the UUID is unavailable.
+static void query_cuda_device_identity(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->cu || !p->cuda_ctx)
+        return;
+    CUcontext dummy;
+    if (CHECK_CU(p->cu->cuCtxPushCurrent(p->cuda_ctx)) < 0)
+        return;
+
+    CUdevice dev = 0;
+    bool have_dev = p->cu->cuCtxGetDevice &&
+                    CHECK_CU(p->cu->cuCtxGetDevice(&dev)) >= 0;
+    if (have_dev) {
+        CUuuid uuid;
+        memset(&uuid, 0, sizeof(uuid));
+        bool have_uuid = false;
+        if (p->cu->cuDeviceGetUuid_v2 &&
+            p->cu->cuDeviceGetUuid_v2(&uuid, dev) == CUDA_SUCCESS) {
+            have_uuid = true;
+        } else if (p->cu->cuDeviceGetUuid &&
+                   p->cu->cuDeviceGetUuid(&uuid, dev) == CUDA_SUCCESS) {
+            have_uuid = true;
+        }
+        if (have_uuid) {
+            snprintf(p->decoder_uuid, sizeof(p->decoder_uuid),
+                     "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
+                     "%02x%02x%02x%02x%02x%02x",
+                     (unsigned char)uuid.bytes[0], (unsigned char)uuid.bytes[1],
+                     (unsigned char)uuid.bytes[2], (unsigned char)uuid.bytes[3],
+                     (unsigned char)uuid.bytes[4], (unsigned char)uuid.bytes[5],
+                     (unsigned char)uuid.bytes[6], (unsigned char)uuid.bytes[7],
+                     (unsigned char)uuid.bytes[8], (unsigned char)uuid.bytes[9],
+                     (unsigned char)uuid.bytes[10], (unsigned char)uuid.bytes[11],
+                     (unsigned char)uuid.bytes[12], (unsigned char)uuid.bytes[13],
+                     (unsigned char)uuid.bytes[14], (unsigned char)uuid.bytes[15]);
+        }
+        int major = 0, minor = 0;
+        if (p->cu->cuDeviceComputeCapability &&
+            p->cu->cuDeviceComputeCapability(&major, &minor, dev) ==
+                CUDA_SUCCESS &&
+            major > 0) {
+            p->sm_major = major;
+            p->sm_minor = minor;
+        }
+    }
+    CHECK_CU(p->cu->cuCtxPopCurrent(&dummy));
+
+    p->device_known = have_dev && (p->decoder_uuid[0] || p->sm_major > 0);
+    status_touch(vf);
+    MP_VERBOSE(vf, "Probe decoder device: uuid=%s sm=%d.%d\n",
+               p->decoder_uuid[0] ? p->decoder_uuid : "(unavailable)",
+               p->sm_major, p->sm_minor);
+}
+
+// The compute device the shim actually runs on: independently queried from the
+// adopted CUDA context the inference context was created with, never copied
+// from the decoder identity. It is recorded in both the ABI's 32-hex form and
+// the dashed form the probe protocol carries.
+static void query_cuda_compute_identity(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->cu || !p->cuda_ctx || p->is_d3d11)
+        return;
+    CUcontext dummy;
+    if (CHECK_CU(p->cu->cuCtxPushCurrent(p->cuda_ctx)) < 0)
+        return;
+
+    CUdevice dev = 0;
+    CUuuid uuid;
+    memset(&uuid, 0, sizeof(uuid));
+    bool ok = p->cu->cuCtxGetDevice &&
+              p->cu->cuCtxGetDevice(&dev) == CUDA_SUCCESS;
+    bool have_uuid = false;
+    if (ok) {
+        if (p->cu->cuDeviceGetUuid_v2 &&
+            p->cu->cuDeviceGetUuid_v2(&uuid, dev) == CUDA_SUCCESS) {
+            have_uuid = true;
+        } else if (p->cu->cuDeviceGetUuid &&
+                   p->cu->cuDeviceGetUuid(&uuid, dev) == CUDA_SUCCESS) {
+            have_uuid = true;
+        }
+    }
+    if (have_uuid) {
+        static const char digits[] = "0123456789abcdef";
+        for (int i = 0; i < 16; i++) {
+            p->compute_uuid_hex[i * 2] = digits[(unsigned char)uuid.bytes[i] >> 4];
+            p->compute_uuid_hex[i * 2 + 1] = digits[(unsigned char)uuid.bytes[i] & 0x0f];
+        }
+        p->compute_uuid_hex[32] = '\0';
+        snprintf(p->compute_uuid, sizeof(p->compute_uuid),
+                 "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
+                 "%02x%02x%02x%02x%02x%02x",
+                 (unsigned char)uuid.bytes[0], (unsigned char)uuid.bytes[1],
+                 (unsigned char)uuid.bytes[2], (unsigned char)uuid.bytes[3],
+                 (unsigned char)uuid.bytes[4], (unsigned char)uuid.bytes[5],
+                 (unsigned char)uuid.bytes[6], (unsigned char)uuid.bytes[7],
+                 (unsigned char)uuid.bytes[8], (unsigned char)uuid.bytes[9],
+                 (unsigned char)uuid.bytes[10], (unsigned char)uuid.bytes[11],
+                 (unsigned char)uuid.bytes[12], (unsigned char)uuid.bytes[13],
+                 (unsigned char)uuid.bytes[14], (unsigned char)uuid.bytes[15]);
+    }
+    CHECK_CU(p->cu->cuCtxPopCurrent(&dummy));
+    p->compute_known = have_uuid;
+    if (!have_uuid) {
+        p->compute_uuid[0] = '\0';
+        p->compute_uuid_hex[0] = '\0';
+    }
+    status_touch(vf);
+    MP_VERBOSE(vf, "Probe compute device: uuid=%s\n",
+               p->compute_uuid[0] ? p->compute_uuid : "(unavailable)");
+}
+
+// The backend a factory query actually reported, as the frozen status token.
+// NONE is the honest answer when nothing was checked: DirectML is never claimed
+// because an ORT runtime happens to be present.
+static const char *factory_backend_name(uint32_t backend)
+{
+    switch (backend) {
+    case AJI_NATIVE_FACTORY_BACKEND_TENSORRT:
+        return "tensorrt";
+    case AJI_NATIVE_FACTORY_BACKEND_DIRECTML:
+        return "directml";
+    default:
+        return "none";
+    }
+}
+
+// The optional producer factory query, executed once per adopted device
+// generation and cached. It runs against the context the frames actually live
+// on: the producer adopts that borrowed context (never creating a second one),
+// reads the real device UUID/CC and initialises/checks its own compiled runtime
+// factory. No model, engine, build or cache is touched, and the answer is a
+// factory-availability fact only - never Prepared/Active/artifactReady. A
+// missing export, a missing context or a malformed reply is an observed
+// unavailability, never a capability read off a symbol, preference or manifest.
+static void query_factory_capabilities(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (p->factory_queried || !p->api.native_query_factory)
+        return;
+    const bool have_device = p->is_d3d11
+#if HAVE_D3D11
+                                 ? p->d3d_dev != NULL
+#else
+                                 ? false
+#endif
+                                 : p->cuda_ctx != NULL;
+    if (!have_device)
+        return;
+
+    aji_create_params cp;
+    memset(&cp, 0, sizeof(cp));
+    cp.api_version = AJI_API_VERSION;
+    cp.cuda_context = p->is_d3d11 ? NULL : p->cuda_ctx;
+#if HAVE_D3D11
+    cp.d3d11_device = p->is_d3d11 ? p->d3d_dev : NULL;
+#endif
+
+    aji_native_factory_capabilities_v1 out;
+    memset(&out, 0, sizeof(out));
+    out.struct_size = sizeof(out);
+    out.requested_protocol = AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION;
+
+    const int rc = p->api.native_query_factory(&cp, &out);
+    // The reply must state the whole identity before any field is trusted; a
+    // producer that answers a different protocol/schema/ABI is a named refusal,
+    // not a capability.
+    const bool identified =
+        out.struct_size == sizeof(out) &&
+        out.protocol_version == AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION &&
+        out.native_protocol_version == AJI_NATIVE_PROTOCOL_VERSION &&
+        out.native_schema_version == AJI_NATIVE_SCHEMA_VERSION &&
+        out.source_abi == AJI_API_VERSION;
+
+    p->factory_queried = true;
+    if (identified) {
+        p->factory = out;
+        p->factory_observed = true;
+        // The reply is a borrowed-style C buffer: force termination inside every
+        // capacity before it is ever read as a string.
+        p->factory.device_identity[sizeof(p->factory.device_identity) - 1] = '\0';
+        p->factory.provider[sizeof(p->factory.provider) - 1] = '\0';
+        p->factory.runtime_version[sizeof(p->factory.runtime_version) - 1] = '\0';
+        p->factory.reason_key[sizeof(p->factory.reason_key) - 1] = '\0';
+        p->factory.reason[sizeof(p->factory.reason) - 1] = '\0';
+        if (p->factory.result != AJI_NATIVE_OK && !p->factory.reason_key[0]) {
+            snprintf(p->factory.reason_key, sizeof(p->factory.reason_key), "%s",
+                     "native.factory.unavailable");
+            snprintf(p->factory.reason, sizeof(p->factory.reason), "%s",
+                     "the factory reported unavailable for the adopted source");
+        }
+    } else {
+        memset(&p->factory, 0, sizeof(p->factory));
+        p->factory.struct_size = sizeof(p->factory);
+        p->factory.requested_protocol = AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION;
+        p->factory.protocol_version = AJI_NATIVE_FACTORY_QUERY_PROTOCOL_VERSION;
+        p->factory.native_protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+        p->factory.native_schema_version = AJI_NATIVE_SCHEMA_VERSION;
+        p->factory.source_abi = AJI_API_VERSION;
+        snprintf(p->factory.reason_key, sizeof(p->factory.reason_key), "%s",
+                 "native.factory.protocol");
+        snprintf(p->factory.reason, sizeof(p->factory.reason), "%s",
+                 "the factory query did not name this build's protocol for the source");
+        p->factory_observed = false;
+    }
+    status_touch(vf);
+    MP_VERBOSE(vf, "Factory query: observed=%d backend=%s roles=0x%x (rc=%d)\n",
+               p->factory_observed, factory_backend_name(p->factory.backend),
+               (unsigned)p->factory.role_bits, rc);
+}
+
+#if HAVE_D3D11
+// The D3D11 source adapter, where supported: queried from the ID3D11Device the
+// incoming AVHWFramesContext borrowed, never inferred from the GUI adapter.
+static void query_d3d11_device_identity(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->d3d_dev)
+        return;
+    IDXGIDevice *dxgi_dev = NULL;
+    IDXGIAdapter *adapter = NULL;
+    if (FAILED(ID3D11Device_QueryInterface(p->d3d_dev, &IID_IDXGIDevice,
+                                           (void **)&dxgi_dev)) ||
+        !dxgi_dev)
+        return;
+    if (SUCCEEDED(IDXGIDevice_GetAdapter(dxgi_dev, &adapter)) && adapter) {
+        DXGI_ADAPTER_DESC desc;
+        if (SUCCEEDED(IDXGIAdapter_GetDesc(adapter, &desc))) {
+            snprintf(p->adapter_luid, sizeof(p->adapter_luid), "%08lx%08lx",
+                     (unsigned long)desc.AdapterLuid.HighPart,
+                     (unsigned long)desc.AdapterLuid.LowPart);
+        }
+        IDXGIAdapter_Release(adapter);
+    }
+    IDXGIDevice_Release(dxgi_dev);
+    p->device_known = p->adapter_luid[0] != '\0';
+    status_touch(vf);
+}
+#endif
+
+// ---- Managed prepared admission -------------------------------------------
+//
+// The Qt serializer sends one compact JSON document per command over the
+// already-working vf-command transport:
+//
+//   vf-command mikai_native admit "<mikai.native.admission/1 document>"
+//   vf-command mikai_native control "<mikai.native.control/1 document>"
+//
+// This filter is the transport and the mpv-side validator, never the source of
+// truth for identity: it checks the plan's source and device facts against the
+// device the frames actually live on and against the CUDA context the shim was
+// created on, then hands the typed plan to the already-open shim's prepared
+// exports from a worker thread so a plan load can never block the playloop. A
+// command returning success is not an acknowledgement; the producer's snapshot
+// and this filter's own post-output facts are. A producer that predates the
+// prepared exports is a named refusal, never a fallback to the conf-driven
+// build path.
+
+static void update_depth(struct mp_filter *vf);
+static void clear_ring(struct mp_filter *vf);
+static void drain_backend(struct mp_filter *vf);
+static bool status_rate_from_fps(double fps, int *num, int *den);
+
+enum {
+    ADMIT_PHASE_NONE = 0,   // no managed plan: the legacy probe/prepare path
+    ADMIT_PHASE_PENDING,    // request stored, the worker is loading it
+    ADMIT_PHASE_PREPARED,   // the producer loaded the plan; no output yet
+    ADMIT_PHASE_ACTIVE,     // a completed output was observed under the plan
+    ADMIT_PHASE_SUSPENDED,  // suspended; the plan and its facts are retained
+    ADMIT_PHASE_FAILED,     // the last admission or control was refused, named
+};
+
+enum {
+    ADMIT_JOB_CREATE = 1,
+    ADMIT_JOB_APPLY = 2,
+    ADMIT_JOB_CONTROL = 3,
+};
+
+struct admit_job {
+    struct mp_filter *vf;
+    uint64_t generation;
+    int kind;
+    uint32_t action;
+    uint32_t timeout_ms;
+    uint64_t epoch;
+    aji_ctx *ctx;
+    CudaFunctions *cu;
+    CUcontext cuda_ctx;
+    void *stream;
+    void *d3d11_dev;
+    uint32_t src_w, src_h;
+    bool is_d3d11;
+    aji_native_prepared_plan_v1 plan;   // read for CREATE and APPLY
+    aji_ctx *created;                   // CREATE only
+    int rc;
+    aji_native_snapshot_v2 snapshot;
+};
+
+static const struct mpv_node *admit_member(const struct mpv_node *map, const char *key)
+{
+    if (!map || map->format != MPV_FORMAT_NODE_MAP || !map->u.list)
+        return NULL;
+    for (int i = 0; i < map->u.list->num; i++) {
+        if (map->u.list->keys && map->u.list->keys[i] &&
+            strcmp(map->u.list->keys[i], key) == 0)
+            return &map->u.list->values[i];
+    }
+    return NULL;
+}
+
+// Strict shape: an unknown member in a fixed-schema object is a refusal, not
+// something to ignore, so a document from a newer producer cannot be read as if
+// it meant this one.
+static bool admit_keys_known(const struct mpv_node *map, const char *const *keys, int count)
+{
+    if (!map || map->format != MPV_FORMAT_NODE_MAP || !map->u.list)
+        return false;
+    for (int i = 0; i < map->u.list->num; i++) {
+        const char *key = map->u.list->keys ? map->u.list->keys[i] : NULL;
+        bool known = false;
+        for (int k = 0; k < count; k++) {
+            if (key && strcmp(key, keys[k]) == 0) {
+                known = true;
+                break;
+            }
+        }
+        if (!known)
+            return false;
+    }
+    return true;
+}
+
+static bool admit_text(const struct mpv_node *map, const char *key, char *dst, size_t cap,
+                       bool required)
+{
+    const struct mpv_node *node = admit_member(map, key);
+    if (!node) {
+        dst[0] = '\0';
+        return !required;
+    }
+    if (node->format != MPV_FORMAT_STRING || !node->u.string)
+        return false;
+    size_t len = strlen(node->u.string);
+    if (len == 0 ? required : len >= cap)
+        return false;
+    memcpy(dst, node->u.string, len + 1);
+    return true;
+}
+
+static bool admit_uint(const struct mpv_node *map, const char *key, uint64_t *out, uint64_t max,
+                       bool required)
+{
+    const struct mpv_node *node = admit_member(map, key);
+    if (!node) {
+        *out = 0;
+        return !required;
+    }
+    if (node->format != MPV_FORMAT_INT64 || node->u.int64 < 0 ||
+        (uint64_t)node->u.int64 > max)
+        return false;
+    *out = (uint64_t)node->u.int64;
+    return true;
+}
+
+// Reads an integer member under either of two accepted spellings. Both are
+// accepted only when they agree; a document that states the same fact twice
+// differently is refused rather than silently preferring one.
+static bool admit_uint_alias(const struct mpv_node *map, const char *primary,
+                             const char *alias, uint64_t *out, uint64_t max, bool required)
+{
+    const struct mpv_node *a = admit_member(map, primary);
+    const struct mpv_node *b = alias ? admit_member(map, alias) : NULL;
+    if (!a && !b) {
+        *out = 0;
+        return !required;
+    }
+    uint64_t va = 0, vb = 0;
+    if (a && !admit_uint(map, primary, &va, max, true))
+        return false;
+    if (b && !admit_uint(map, alias, &vb, max, true))
+        return false;
+    if (a && b && va != vb)
+        return false;
+    *out = a ? va : vb;
+    return true;
+}
+
+static bool admit_text_alias(const struct mpv_node *map, const char *primary, const char *alias,
+                             char *dst, size_t cap, bool required)
+{
+    const struct mpv_node *a = admit_member(map, primary);
+    const struct mpv_node *b = alias ? admit_member(map, alias) : NULL;
+    if (!a && !b)
+        return admit_text(map, primary, dst, cap, required);
+    char other[128];
+    if (a && !admit_text(map, primary, dst, cap, required))
+        return false;
+    if (b && !admit_text(map, alias, other, sizeof(other), required))
+        return false;
+    if (a && b && strcmp(dst, other) != 0)
+        return false;
+    if (!a)
+        memcpy(dst, other, strlen(other) + 1);
+    return true;
+}
+
+static bool admit_number(const struct mpv_node *map, const char *key, double *out, bool required)
+{
+    const struct mpv_node *node = admit_member(map, key);
+    if (!node) {
+        *out = 0;
+        return !required;
+    }
+    if (node->format == MPV_FORMAT_DOUBLE) {
+        *out = node->u.double_;
+        return true;
+    }
+    if (node->format == MPV_FORMAT_INT64) {
+        *out = (double)node->u.int64;
+        return true;
+    }
+    return false;
+}
+
+static bool admit_hex(const char *text, size_t len)
+{
+    if (strlen(text) != len)
+        return false;
+    for (size_t i = 0; i < len; i++) {
+        const char c = text[i];
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+            return false;
+    }
+    return true;
+}
+
+static bool admit_absolute_path(const char *path)
+{
+    if (!path[0])
+        return false;
+#ifdef _WIN32
+    return (path[0] == '\\' && path[1] == '\\') ||
+           (((path[0] >= 'A' && path[0] <= 'Z') ||
+             (path[0] >= 'a' && path[0] <= 'z')) && path[1] == ':' &&
+            (path[2] == '\\' || path[2] == '/'));
+#else
+    return path[0] == '/';
+#endif
+}
+
+// "[1,C,H,W]" exactly: a positive batch of one, positive channels and extents.
+static bool admit_shape(const struct mpv_node *node, uint32_t *channels, uint32_t *w, uint32_t *h)
+{
+    if (!node || node->format != MPV_FORMAT_NODE_ARRAY || !node->u.list ||
+        node->u.list->num != 4)
+        return false;
+    uint32_t dims[4];
+    for (int i = 0; i < 4; i++) {
+        const struct mpv_node *v = &node->u.list->values[i];
+        if (v->format != MPV_FORMAT_INT64 || v->u.int64 <= 0 || v->u.int64 > 0x7fffffff)
+            return false;
+        dims[i] = (uint32_t)v->u.int64;
+    }
+    if (dims[0] != 1)
+        return false;
+    *channels = dims[1];
+    *h = dims[2];
+    *w = dims[3];
+    return true;
+}
+
+static bool admit_reject(char *reason, size_t rn, const char *key, const char *text)
+{
+    snprintf(reason, rn, "%s: %s", key, text);
+    return false;
+}
+
+static int admit_spatial_count(const aji_native_prepared_plan_v1 *plan)
+{
+    int count = 0;
+    for (uint32_t i = 0; i < plan->stage_count; i++) {
+        if (plan->stages[i].role == AJI_NATIVE_ROLE_SPATIAL)
+            count++;
+    }
+    return count;
+}
+
+static const aji_native_prepared_stage_v1 *admit_temporal_stage(
+    const aji_native_prepared_plan_v1 *plan)
+{
+    for (uint32_t i = 0; i < plan->stage_count; i++) {
+        if (plan->stages[i].role == AJI_NATIVE_ROLE_TEMPORAL)
+            return &plan->stages[i];
+    }
+    return NULL;
+}
+
+static bool admit_parse_source(const struct mpv_node *node, aji_native_prepared_plan_v1 *plan,
+                               char *reason, size_t rn)
+{
+    static const char *const keys[] = {"codedWidth", "codedHeight", "codedW", "codedH", "crop",
+                                       "rotation", "fps", "csp", "matrix", "range", "siting",
+                                       "bitDepth"};
+    if (!node || node->format != MPV_FORMAT_NODE_MAP)
+        return admit_reject(reason, rn, "native.admission.source", "not an object");
+    if (!admit_keys_known(node, keys, MP_ARRAY_SIZE(keys)))
+        return admit_reject(reason, rn, "native.admission.source.unknown.member",
+                            "a key this schema does not define");
+    uint64_t value = 0;
+    if (!admit_uint_alias(node, "codedWidth", "codedW", &value, 0x7fffffff, true) || value == 0)
+        return admit_reject(reason, rn, "native.admission.source.coded",
+                            "codedWidth must be a positive integer");
+    plan->source_coded_width = (uint32_t)value;
+    if (!admit_uint_alias(node, "codedHeight", "codedH", &value, 0x7fffffff, true) || value == 0)
+        return admit_reject(reason, rn, "native.admission.source.coded",
+                            "codedHeight must be a positive integer");
+    plan->source_coded_height = (uint32_t)value;
+
+    const struct mpv_node *crop = admit_member(node, "crop");
+    if (crop) {
+        static const char *const crop_keys[] = {"x", "y", "width", "height", "w", "h"};
+        if (!admit_keys_known(crop, crop_keys, MP_ARRAY_SIZE(crop_keys)))
+            return admit_reject(reason, rn, "native.admission.source.crop.unknown.member",
+                                "a key this schema does not define");
+        uint64_t x = 0, y = 0, cw = 0, ch = 0;
+        if (!admit_uint(crop, "x", &x, 0x7fffffff, true) ||
+            !admit_uint(crop, "y", &y, 0x7fffffff, true) ||
+            !admit_uint_alias(crop, "width", "w", &cw, 0x7fffffff, true) ||
+            !admit_uint_alias(crop, "height", "h", &ch, 0x7fffffff, true))
+            return admit_reject(reason, rn, "native.admission.source.crop",
+                                "x, y, width and height must be non-negative integers");
+        if (cw == 0 || ch == 0 || x + cw > plan->source_coded_width ||
+            y + ch > plan->source_coded_height)
+            return admit_reject(reason, rn, "native.admission.source.crop",
+                                "the crop reaches outside the coded frame");
+        plan->source_crop_x = (uint32_t)x;
+        plan->source_crop_y = (uint32_t)y;
+        plan->source_crop_width = (uint32_t)cw;
+        plan->source_crop_height = (uint32_t)ch;
+    }
+
+    if (!admit_uint(node, "rotation", &value, 270, true) ||
+        (value != 0 && value != 90 && value != 180 && value != 270))
+        return admit_reject(reason, rn, "native.admission.source.rotation",
+                            "rotation must be 0, 90, 180 or 270");
+    plan->source_rotation = (uint32_t)value;
+
+    const struct mpv_node *fps = admit_member(node, "fps");
+    static const char *const fps_keys[] = {"num", "den"};
+    if (!fps || !admit_keys_known(fps, fps_keys, MP_ARRAY_SIZE(fps_keys)))
+        return admit_reject(reason, rn, "native.admission.source.fps",
+                            "fps must be an object with num and den");
+    uint64_t num = 0, den = 0;
+    if (!admit_uint(fps, "num", &num, 1000000, true) || num == 0 ||
+        !admit_uint(fps, "den", &den, 1000000, true) || den == 0)
+        return admit_reject(reason, rn, "native.admission.source.fps",
+                            "num and den must be positive and at most 1000000");
+    plan->source_fps_num = (uint32_t)num;
+    plan->source_fps_den = (uint32_t)den;
+
+    if (!admit_text(node, "csp", plan->source_csp, sizeof(plan->source_csp), true))
+        return admit_reject(reason, rn, "native.admission.source.csp", "missing or too long");
+    if (!admit_text(node, "matrix", plan->source_matrix, sizeof(plan->source_matrix), false) ||
+        !admit_text(node, "range", plan->source_range, sizeof(plan->source_range), false) ||
+        !admit_text(node, "siting", plan->source_siting, sizeof(plan->source_siting), false))
+        return admit_reject(reason, rn, "native.admission.source.colour", "a text member is too long");
+    if (!admit_uint(node, "bitDepth", &value, 32, true) ||
+        (value != 8 && value != 10 && value != 12 && value != 16))
+        return admit_reject(reason, rn, "native.admission.source.bitDepth",
+                            "bitDepth must be 8, 10, 12 or 16");
+    plan->source_bit_depth = (uint32_t)value;
+    return true;
+}
+
+static bool admit_parse_device(const struct mpv_node *node, aji_native_prepared_plan_v1 *plan,
+                               char *reason, size_t rn)
+{
+    static const char *const keys[] = {"decoderDeviceUuid", "computeDeviceUuid", "adapterLuid",
+                                       "smMajor", "smMinor"};
+    if (!node || node->format != MPV_FORMAT_NODE_MAP)
+        return admit_reject(reason, rn, "native.admission.device", "not an object");
+    if (!admit_keys_known(node, keys, MP_ARRAY_SIZE(keys)))
+        return admit_reject(reason, rn, "native.admission.device.unknown.member",
+                            "a key this schema does not define");
+    if (!admit_text(node, "decoderDeviceUuid", plan->decoder_device_uuid,
+                    sizeof(plan->decoder_device_uuid), false) ||
+        !admit_text(node, "computeDeviceUuid", plan->compute_device_uuid,
+                    sizeof(plan->compute_device_uuid), false) ||
+        !admit_text(node, "adapterLuid", plan->adapter_luid, sizeof(plan->adapter_luid), false))
+        return admit_reject(reason, rn, "native.admission.device",
+                            "a device identity member is too long");
+    uint64_t sm_major = 0, sm_minor = 0;
+    if (!admit_uint(node, "smMajor", &sm_major, 1024, true) ||
+        !admit_uint(node, "smMinor", &sm_minor, 1024, true))
+        return admit_reject(reason, rn, "native.admission.device.sm",
+                            "smMajor and smMinor must be integers in [0,1024]");
+    plan->device_sm_major = (uint32_t)sm_major;
+    plan->device_sm_minor = (uint32_t)sm_minor;
+    if (!plan->compute_device_uuid[0] && !plan->adapter_luid[0])
+        return admit_reject(reason, rn, "native.admission.device",
+                            "neither a compute device UUID nor an adapter LUID is stated");
+    return true;
+}
+
+static bool admit_parse_build(const struct mpv_node *node, aji_native_prepared_plan_v1 *plan,
+                              char *reason, size_t rn)
+{
+    static const char *const keys[] = {"provider", "runtime", "runtimeVersion", "plugin",
+                                       "pluginVersion", "coreSha", "sourceAbi", "precision",
+                                       "tf32", "stronglyTyped", "skipInference", "deviceUuid",
+                                       "adapterLuid", "smMajor", "smMinor", "cudaVersion",
+                                       "driverVersion", "canonicalOptions"};
+    if (!node || node->format != MPV_FORMAT_NODE_MAP)
+        return admit_reject(reason, rn, "native.admission.build", "not an object");
+    if (!admit_keys_known(node, keys, MP_ARRAY_SIZE(keys)))
+        return admit_reject(reason, rn, "native.admission.build.unknown.member",
+                            "a key this schema does not define");
+    if (!admit_text(node, "provider", plan->build_provider, sizeof(plan->build_provider), true) ||
+        !admit_text_alias(node, "runtime", "runtimeVersion", plan->build_runtime,
+                          sizeof(plan->build_runtime), true) ||
+        !admit_text_alias(node, "plugin", "pluginVersion", plan->build_plugin,
+                          sizeof(plan->build_plugin), true) ||
+        !admit_text(node, "precision", plan->build_precision, sizeof(plan->build_precision), true))
+        return admit_reject(reason, rn, "native.admission.build",
+                            "provider, runtime, plugin and precision are required and bounded");
+    // The build identity repeats the observed device facts; when present they
+    // must be the same device the device object names, never a second story.
+    char device_uuid[128] = {0}, build_luid[128] = {0}, cuda_version[128] = {0};
+    char driver_version[128] = {0};
+    if (!admit_text(node, "deviceUuid", device_uuid, sizeof(device_uuid), false) ||
+        !admit_text(node, "adapterLuid", build_luid, sizeof(build_luid), false) ||
+        !admit_text(node, "cudaVersion", cuda_version, sizeof(cuda_version), false) ||
+        !admit_text(node, "driverVersion", driver_version, sizeof(driver_version), false))
+        return admit_reject(reason, rn, "native.admission.build.device", "a member is too long");
+    if (device_uuid[0] && plan->compute_device_uuid[0] &&
+        strcmp(device_uuid, plan->compute_device_uuid) != 0)
+        return admit_reject(reason, rn, "native.admission.build.deviceUuid",
+                            "build deviceUuid disagrees with the device object");
+    if (build_luid[0] && plan->adapter_luid[0] && strcmp(build_luid, plan->adapter_luid) != 0)
+        return admit_reject(reason, rn, "native.admission.build.adapterLuid",
+                            "build adapterLuid disagrees with the device object");
+    uint64_t build_sm_major = 0, build_sm_minor = 0;
+    if (!admit_uint(node, "smMajor", &build_sm_major, 1024, false) ||
+        !admit_uint(node, "smMinor", &build_sm_minor, 1024, false))
+        return admit_reject(reason, rn, "native.admission.build.sm", "not an integer in [0,1024]");
+    if (admit_member(node, "smMajor") &&
+        ((uint32_t)build_sm_major != plan->device_sm_major ||
+         (uint32_t)build_sm_minor != plan->device_sm_minor))
+        return admit_reject(reason, rn, "native.admission.build.sm",
+                            "build SM disagrees with the device object");
+    if (strcmp(plan->build_precision, "fp16") != 0 && strcmp(plan->build_precision, "fp32") != 0)
+        return admit_reject(reason, rn, "native.admission.build.precision",
+                            "precision must be fp16 or fp32");
+    if (!admit_text(node, "coreSha", plan->build_core_sha, sizeof(plan->build_core_sha), true) ||
+        !(admit_hex(plan->build_core_sha, 40) || admit_hex(plan->build_core_sha, 64)))
+        return admit_reject(reason, rn, "native.admission.build.coreSha",
+                            "coreSha must be 40 or 64 lower-case hex digits");
+    if (!admit_text(node, "canonicalOptions", plan->build_options, sizeof(plan->build_options),
+                    false))
+        return admit_reject(reason, rn, "native.admission.build.options", "too long");
+    uint64_t value = 0;
+    if (!admit_uint(node, "sourceAbi", &value, 1024, true))
+        return admit_reject(reason, rn, "native.admission.build.sourceAbi", "must be an integer");
+    plan->build_source_abi = (uint32_t)value;
+    if (!admit_uint(node, "tf32", &value, 1, true))
+        return admit_reject(reason, rn, "native.admission.build.tf32", "must be 0 or 1");
+    plan->build_tf32 = (uint32_t)value;
+    if (!admit_uint(node, "stronglyTyped", &value, 1, true))
+        return admit_reject(reason, rn, "native.admission.build.stronglyTyped", "must be 0 or 1");
+    plan->build_strongly_typed = (uint32_t)value;
+    if (!admit_uint(node, "skipInference", &value, 1, true))
+        return admit_reject(reason, rn, "native.admission.build.skipInference", "must be 0 or 1");
+    plan->build_skip_inference = (uint32_t)value;
+    return true;
+}
+
+static bool admit_parse_stage(const struct mpv_node *node, uint32_t index,
+                              aji_native_prepared_plan_v1 *plan, char *reason, size_t rn)
+{
+    static const char *const keys[] = {
+        "ordinal", "role", "order", "modelId", "modelContentId", "modelSha256", "engineSha256",
+        "buildKey", "modelPath", "enginePath", "inputTensor", "outputTensor", "inputDtype",
+        "outputDtype", "layout", "inputShape", "outputShape", "contentSize", "padLeft", "padTop",
+        "factor", "sceneThreshold"};
+    if (!node || node->format != MPV_FORMAT_NODE_MAP)
+        return admit_reject(reason, rn, "native.admission.stage", "not an object");
+    if (!admit_keys_known(node, keys, MP_ARRAY_SIZE(keys)))
+        return admit_reject(reason, rn, "native.admission.stage.unknown.member",
+                            "a key this schema does not define");
+    aji_native_prepared_stage_v1 *stage = &plan->stages[index];
+    memset(stage, 0, sizeof(*stage));
+    stage->struct_size = sizeof(*stage);
+    uint64_t value = 0;
+    if (!admit_uint(node, "ordinal", &value, AJI_NATIVE_MAX_STAGES, true) || value != index)
+        return admit_reject(reason, rn, "native.admission.stage.ordinal",
+                            "ordinals must start at 0 and strictly ascend");
+    stage->ordinal = (uint32_t)value;
+
+    char text[64];
+    if (!admit_text(node, "role", text, sizeof(text), true))
+        return admit_reject(reason, rn, "native.admission.stage.role", "missing or too long");
+    if (strcmp(text, "spatial") == 0) {
+        stage->role = AJI_NATIVE_ROLE_SPATIAL;
+        stage->order = AJI_NATIVE_ORDER_NONE;
+        if (admit_member(node, "factor") || admit_member(node, "sceneThreshold"))
+            return admit_reject(reason, rn, "native.admission.stage.temporalFacts",
+                                "a spatial stage carries temporal facts");
+    } else if (strcmp(text, "temporal") == 0) {
+        stage->role = AJI_NATIVE_ROLE_TEMPORAL;
+    } else {
+        return admit_reject(reason, rn, "native.admission.stage.role",
+                            "role must be spatial or temporal");
+    }
+
+    if (stage->role == AJI_NATIVE_ROLE_TEMPORAL) {
+        if (!admit_text(node, "order", text, sizeof(text), true))
+            return admit_reject(reason, rn, "native.admission.stage.order", "missing or too long");
+        if (strcmp(text, "before_spatial") == 0 || strcmp(text, "beforeSpatial") == 0) {
+            stage->order = AJI_NATIVE_ORDER_BEFORE_SPATIAL;
+        } else if (strcmp(text, "after_spatial") == 0 || strcmp(text, "afterSpatial") == 0) {
+            stage->order = AJI_NATIVE_ORDER_AFTER_SPATIAL;
+        } else {
+            return admit_reject(reason, rn, "native.admission.stage.order",
+                                "a temporal stage needs a before/after-spatial order");
+        }
+        const struct mpv_node *factor = admit_member(node, "factor");
+        static const char *const factor_keys[] = {"num", "den"};
+        if (!factor || !admit_keys_known(factor, factor_keys, MP_ARRAY_SIZE(factor_keys)))
+            return admit_reject(reason, rn, "native.admission.stage.factor",
+                                "a temporal stage needs a factor object");
+        uint64_t num = 0, den = 0;
+        if (!admit_uint(factor, "num", &num, 1024, true) || num == 0 ||
+            !admit_uint(factor, "den", &den, 1024, true) || den == 0)
+            return admit_reject(reason, rn, "native.admission.stage.factor",
+                                "factor num and den must be positive");
+        if (num <= den)
+            return admit_reject(reason, rn, "native.admission.stage.factor",
+                                "a temporal factor must interpolate, so num must exceed den");
+        stage->factor_num = (uint32_t)num;
+        stage->factor_den = (uint32_t)den;
+        double threshold = 0;
+        if (!admit_number(node, "sceneThreshold", &threshold, true) ||
+            !(threshold >= 0.0) || !(threshold <= 1.0))
+            return admit_reject(reason, rn, "native.admission.stage.sceneThreshold",
+                                "sceneThreshold must be a number in [0,1]");
+        stage->scene_threshold = threshold;
+    }
+
+    if (!admit_text(node, "modelId", stage->model_id, sizeof(stage->model_id), true) ||
+        !admit_text(node, "modelContentId", stage->model_content_id,
+                    sizeof(stage->model_content_id), true) ||
+        !admit_text(node, "buildKey", stage->build_key, sizeof(stage->build_key), true))
+        return admit_reject(reason, rn, "native.admission.stage.identity",
+                            "modelId, modelContentId and buildKey are required identities");
+    if (!admit_text(node, "modelSha256", stage->model_sha256, sizeof(stage->model_sha256), true) ||
+        !admit_hex(stage->model_sha256, 64))
+        return admit_reject(reason, rn, "native.admission.stage.modelSha256",
+                            "modelSha256 must be 64 lower-case hex digits");
+    if (!admit_text(node, "engineSha256", stage->engine_sha256, sizeof(stage->engine_sha256),
+                    true) || !admit_hex(stage->engine_sha256, 64))
+        return admit_reject(reason, rn, "native.admission.stage.engineSha256",
+                            "engineSha256 must be 64 lower-case hex digits");
+    if (!admit_text(node, "modelPath", stage->model_path, sizeof(stage->model_path), true) ||
+        !admit_absolute_path(stage->model_path))
+        return admit_reject(reason, rn, "native.admission.stage.modelPath",
+                            "modelPath must be an absolute owned path");
+    if (!admit_text(node, "enginePath", stage->engine_path, sizeof(stage->engine_path), true) ||
+        !admit_absolute_path(stage->engine_path))
+        return admit_reject(reason, rn, "native.admission.stage.enginePath",
+                            "enginePath must be an absolute owned path");
+    if (!admit_text(node, "inputTensor", stage->input_tensor, sizeof(stage->input_tensor), false) ||
+        !admit_text(node, "outputTensor", stage->output_tensor, sizeof(stage->output_tensor),
+                    false))
+        return admit_reject(reason, rn, "native.admission.stage.tensor", "too long");
+
+    char input_dtype[16], output_dtype[16];
+    if (!admit_text(node, "inputDtype", input_dtype, sizeof(input_dtype), true) ||
+        !admit_text(node, "outputDtype", output_dtype, sizeof(output_dtype), true))
+        return admit_reject(reason, rn, "native.admission.stage.dtype", "missing or too long");
+    stage->input_dtype = strcmp(input_dtype, "fp16") == 0 ? AJI_NATIVE_DTYPE_FP16 :
+                         strcmp(input_dtype, "fp32") == 0 ? AJI_NATIVE_DTYPE_FP32 : 0;
+    stage->output_dtype = strcmp(output_dtype, "fp16") == 0 ? AJI_NATIVE_DTYPE_FP16 :
+                          strcmp(output_dtype, "fp32") == 0 ? AJI_NATIVE_DTYPE_FP32 : 0;
+    if (!stage->input_dtype || !stage->output_dtype)
+        return admit_reject(reason, rn, "native.admission.stage.dtype",
+                            "dtypes must be fp16 or fp32");
+
+    if (!admit_text(node, "layout", text, sizeof(text), true) || strcmp(text, "chw") != 0)
+        return admit_reject(reason, rn, "native.admission.stage.layout", "layout must be chw");
+    stage->input_layout = AJI_NATIVE_LAYOUT_CHW;
+    stage->output_layout = AJI_NATIVE_LAYOUT_CHW;
+
+    uint32_t in_channels = 0, out_channels = 0;
+    if (!admit_shape(admit_member(node, "inputShape"), &in_channels, &stage->input_width,
+                     &stage->input_height))
+        return admit_reject(reason, rn, "native.admission.stage.inputShape",
+                            "inputShape must be [1,C,H,W] of positive integers");
+    if (!admit_shape(admit_member(node, "outputShape"), &out_channels, &stage->output_width,
+                     &stage->output_height))
+        return admit_reject(reason, rn, "native.admission.stage.outputShape",
+                            "outputShape must be [1,C,H,W] of positive integers");
+    stage->input_channels = in_channels;
+    stage->output_channels = out_channels;
+    // The producer binds an even frame of at least 2x2 and a temporal stage
+    // never rescales; chain geometry beyond that is the plan's own.
+    if (stage->input_width < 2 || stage->input_height < 2 ||
+        stage->output_width < 2 || stage->output_height < 2 ||
+        (stage->input_width & 1) || (stage->input_height & 1) ||
+        (stage->output_width & 1) || (stage->output_height & 1))
+        return admit_reject(reason, rn, "native.admission.stage.geometry",
+                            "stage geometry must be an even frame of at least 2x2");
+    if (stage->role == AJI_NATIVE_ROLE_TEMPORAL &&
+        (stage->input_width != stage->output_width ||
+         stage->input_height != stage->output_height))
+        return admit_reject(reason, rn, "native.admission.stage.geometry",
+                            "a temporal stage must not rescale");
+
+    const struct mpv_node *content = admit_member(node, "contentSize");
+    static const char *const content_keys[] = {"w", "h"};
+    if (!content || !admit_keys_known(content, content_keys, MP_ARRAY_SIZE(content_keys)))
+        return admit_reject(reason, rn, "native.admission.stage.contentSize",
+                            "contentSize must be an object with w and h");
+    uint64_t cw = 0, ch = 0;
+    if (!admit_uint(content, "w", &cw, 0x7fffffff, true) || cw == 0 ||
+        !admit_uint(content, "h", &ch, 0x7fffffff, true) || ch == 0)
+        return admit_reject(reason, rn, "native.admission.stage.contentSize",
+                            "contentSize w and h must be positive integers");
+    stage->content_width = (uint32_t)cw;
+    stage->content_height = (uint32_t)ch;
+
+    uint64_t pad_left = 0, pad_top = 0;
+    if (!admit_uint(node, "padLeft", &pad_left, 0x7fffffff, true) ||
+        !admit_uint(node, "padTop", &pad_top, 0x7fffffff, true))
+        return admit_reject(reason, rn, "native.admission.stage.pad",
+                            "padLeft and padTop must be non-negative integers");
+    stage->pad_left = (uint32_t)pad_left;
+    stage->pad_top = (uint32_t)pad_top;
+
+    // The pad is the exact centred, even margin of the frame window inside the
+    // engine bind geometry; a spatial stage pads nothing.
+    if (stage->input_width < stage->content_width || stage->input_height < stage->content_height)
+        return admit_reject(reason, rn, "native.admission.stage.geometry",
+                            "the engine input is smaller than the frame window");
+    uint32_t want_left = (stage->input_width - stage->content_width) / 2;
+    uint32_t want_top = (stage->input_height - stage->content_height) / 2;
+    if ((stage->input_width - stage->content_width) % 2 ||
+        (stage->input_height - stage->content_height) % 2 ||
+        stage->pad_left != want_left || stage->pad_top != want_top)
+        return admit_reject(reason, rn, "native.admission.stage.pad",
+                            "padLeft/padTop are not the centred even pad of the frame window");
+    if (stage->role == AJI_NATIVE_ROLE_SPATIAL &&
+        (stage->pad_left || stage->pad_top || stage->input_width != stage->content_width ||
+         stage->input_height != stage->content_height))
+        return admit_reject(reason, rn, "native.admission.stage.geometry",
+                            "a spatial stage cannot pad or reframe the frame window");
+    return true;
+}
+
+static bool admit_parse_plan(const struct mpv_node *root, aji_native_prepared_plan_v1 *plan,
+                             char *reason, size_t rn)
+{
+    static const char *const keys[] = {"schema", "protocol", "requestId", "revision", "epoch",
+                                       "requested", "source", "device", "build", "stages"};
+    if (!root || root->format != MPV_FORMAT_NODE_MAP)
+        return admit_reject(reason, rn, "native.admission.malformed", "not a JSON object");
+    if (!admit_keys_known(root, keys, MP_ARRAY_SIZE(keys)))
+        return admit_reject(reason, rn, "native.admission.unknown.member",
+                            "a key this schema does not define");
+    memset(plan, 0, sizeof(*plan));
+    plan->struct_size = sizeof(*plan);
+    plan->requested_protocol = AJI_NATIVE_PREPARED_PROTOCOL_VERSION;
+    plan->flags = AJI_NATIVE_PLAN_FLAG_PREPARED_ONLY;
+
+    char text[128];
+    if (!admit_text(root, "schema", text, sizeof(text), true) ||
+        strcmp(text, "mikai.native.admission/1") != 0)
+        return admit_reject(reason, rn, "native.admission.schema",
+                            "schema must be mikai.native.admission/1");
+    uint64_t value = 0;
+    if (!admit_uint(root, "protocol", &value, 1024, true) || value != 1)
+        return admit_reject(reason, rn, "native.admission.protocol", "protocol must be 1");
+    if (!admit_text(root, "requestId", plan->requested_plan, sizeof(plan->requested_plan), true))
+        return admit_reject(reason, rn, "native.admission.requestId", "missing or too long");
+    if (!admit_uint(root, "revision", &value, UINT64_MAX, true))
+        return admit_reject(reason, rn, "native.admission.revision", "must be a non-negative integer");
+    plan->revision = value;
+    if (!admit_uint(root, "epoch", &value, UINT64_MAX, true))
+        return admit_reject(reason, rn, "native.admission.epoch", "must be a non-negative integer");
+    plan->epoch = value;
+
+    const struct mpv_node *requested = admit_member(root, "requested");
+    static const char *const requested_keys[] = {"recipe", "backend"};
+    if (!requested || !admit_keys_known(requested, requested_keys,
+                                        MP_ARRAY_SIZE(requested_keys)))
+        return admit_reject(reason, rn, "native.admission.requested",
+                            "requested must be an object with recipe and backend");
+    if (!admit_text(requested, "recipe", plan->recipe_id, sizeof(plan->recipe_id), true))
+        return admit_reject(reason, rn, "native.admission.requested.recipe", "missing or too long");
+    if (!admit_text(requested, "backend", plan->backend, sizeof(plan->backend), true) ||
+        (strcmp(plan->backend, "tensorrt") != 0 && strcmp(plan->backend, "directml") != 0))
+        return admit_reject(reason, rn, "native.admission.requested.backend",
+                            "backend must be tensorrt or directml");
+
+    if (!admit_parse_source(admit_member(root, "source"), plan, reason, rn) ||
+        !admit_parse_device(admit_member(root, "device"), plan, reason, rn) ||
+        !admit_parse_build(admit_member(root, "build"), plan, reason, rn))
+        return false;
+
+    const struct mpv_node *stages = admit_member(root, "stages");
+    if (!stages || stages->format != MPV_FORMAT_NODE_ARRAY || !stages->u.list ||
+        stages->u.list->num < 1 || stages->u.list->num > (int)AJI_NATIVE_MAX_STAGES)
+        return admit_reject(reason, rn, "native.admission.stages",
+                            "stages must be a non-empty array of at most 9 entries");
+    plan->stage_count = (uint32_t)stages->u.list->num;
+    for (uint32_t i = 0; i < plan->stage_count; i++) {
+        if (!admit_parse_stage(&stages->u.list->values[i], i, plan, reason, rn))
+            return false;
+    }
+
+    // Ordering: a before-spatial stage must precede every spatial stage (it is
+    // the first stage), an after-spatial one must follow them all (it is the
+    // last), and only one temporal stage can exist because the consumed status
+    // reports exactly one factor. A temporal-only chain is legal.
+    int temporal_index = -1, temporal_count = 0;
+    for (uint32_t i = 0; i < plan->stage_count; i++) {
+        if (plan->stages[i].role == AJI_NATIVE_ROLE_TEMPORAL) {
+            temporal_count++;
+            temporal_index = (int)i;
+        }
+    }
+    if (temporal_count > 1)
+        return admit_reject(reason, rn, "native.admission.stage.order",
+                            "at most one temporal stage can be admitted");
+    if (temporal_index >= 0) {
+        const aji_native_prepared_stage_v1 *stage = &plan->stages[temporal_index];
+        if (stage->order == AJI_NATIVE_ORDER_BEFORE_SPATIAL && temporal_index != 0)
+            return admit_reject(reason, rn, "native.admission.stage.order",
+                                "a before-spatial stage must precede every spatial stage");
+        if (stage->order == AJI_NATIVE_ORDER_AFTER_SPATIAL &&
+            (uint32_t)(temporal_index + 1) != plan->stage_count)
+            return admit_reject(reason, rn, "native.admission.stage.order",
+                                "an after-spatial stage must follow every spatial stage");
+    }
+
+    const aji_native_prepared_stage_v1 *temporal = admit_temporal_stage(plan);
+    if (temporal) {
+        uint64_t num = temporal->factor_num, den = temporal->factor_den;
+        if (num > 8 * den)
+            return admit_reject(reason, rn, "native.admission.stage.factor",
+                                "the interpolation factor exceeds the eight outputs per pair "
+                                "this pipeline carries");
+    }
+
+    // Stage geometry is the chain's own business: the producer inserts a resize
+    // wherever a stage's input differs from the running window, so an initial
+    // resize (a crop- or rotation-derived display window feeding a larger engine
+    // input) is legitimate and is not refused here. What is checked is the
+    // structural contract the producer also enforces.
+    return true;
+}
+
+static bool admit_parse_control(const struct mpv_node *root, char *action, size_t an,
+                                uint64_t *epoch, uint64_t *revision, uint32_t *timeout_ms,
+                                char *reason, size_t rn)
+{
+    static const char *const keys[] = {"schema", "protocol", "action", "epoch", "revision",
+                                       "timeoutMs"};
+    if (!root || root->format != MPV_FORMAT_NODE_MAP)
+        return admit_reject(reason, rn, "native.control.malformed", "not a JSON object");
+    if (!admit_keys_known(root, keys, MP_ARRAY_SIZE(keys)))
+        return admit_reject(reason, rn, "native.control.unknown.member",
+                            "a key this schema does not define");
+    char schema[128];
+    if (!admit_text(root, "schema", schema, sizeof(schema), true) ||
+        strcmp(schema, "mikai.native.control/1") != 0)
+        return admit_reject(reason, rn, "native.control.schema",
+                            "schema must be mikai.native.control/1");
+    uint64_t value = 0;
+    if (!admit_uint(root, "protocol", &value, 1024, true) || value != 1)
+        return admit_reject(reason, rn, "native.control.protocol", "protocol must be 1");
+    if (!admit_text(root, "action", action, an, true) ||
+        (strcmp(action, "drain") != 0 && strcmp(action, "suspend") != 0 &&
+         strcmp(action, "resume") != 0))
+        return admit_reject(reason, rn, "native.control.action",
+                            "action must be drain, suspend or resume");
+    if (!admit_uint(root, "epoch", epoch, UINT64_MAX, true))
+        return admit_reject(reason, rn, "native.control.epoch", "must be a non-negative integer");
+    if (!admit_uint(root, "revision", revision, UINT64_MAX, true))
+        return admit_reject(reason, rn, "native.control.revision", "must be a non-negative integer");
+    if (!admit_uint(root, "timeoutMs", &value, 3600000, true))
+        return admit_reject(reason, rn, "native.control.timeoutMs",
+                            "timeoutMs must be an integer in [0,3600000]");
+    *timeout_ms = (uint32_t)value;
+    return true;
+}
+
+// The plan's source and device facts are checked against what the filter
+// actually observes on the adopted device, never against the document's own
+// consistency: a plan that describes a different frame or a different device is
+// refused by name before the producer sees it.
+static bool admit_uuid_contains(const char *text, const char *hex32)
+{
+    size_t n = strlen(hex32);
+    if (!n || strlen(text) < n)
+        return false;
+    for (size_t i = 0; text[i]; i++) {
+        size_t j = 0;
+        while (j < n && text[i + j]) {
+            char a = text[i + j], b = hex32[j];
+            if (a >= 'A' && a <= 'F') a += 'a' - 'A';
+            if (a != b)
+                break;
+            j++;
+        }
+        if (j == n)
+            return true;
+    }
+    return false;
+}
+
+// The display geometry the producer resolves the plan to (crop, then
+// rotation). This filter feeds coded frames, so a plan whose display geometry
+// differs from the coded frame is one it cannot execute and refuses by name.
+static bool admit_display_size(const aji_native_prepared_plan_v1 *plan, int *w, int *h)
+{
+    int cw = (int)plan->source_coded_width;
+    int ch = (int)plan->source_coded_height;
+    if (plan->source_crop_width && plan->source_crop_height) {
+        cw = (int)plan->source_crop_width;
+        ch = (int)plan->source_crop_height;
+    }
+    if (cw < 2 || ch < 2)
+        return false;
+    switch (plan->source_rotation) {
+    case 0:
+    case 180:
+        *w = cw;
+        *h = ch;
+        return true;
+    case 90:
+    case 270:
+        *w = ch;
+        *h = cw;
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool admit_validate_actual(struct mp_filter *vf, aji_native_prepared_plan_v1 *plan,
+                                  char *reason, size_t rn)
+{
+    struct priv *p = vf->priv;
+    if (!p->configured || !p->params.w || !p->params.h)
+        return admit_reject(reason, rn, "native.admission.source",
+                            "no adopted hardware frames context has been observed yet");
+    if ((int)plan->source_coded_width != p->params.w ||
+        (int)plan->source_coded_height != p->params.h)
+        return admit_reject(reason, rn, "native.admission.source.coded",
+                            "the plan's coded size is not the observed frame size");
+    if (plan->source_rotation != (uint32_t)p->params.rotate)
+        return admit_reject(reason, rn, "native.admission.source.rotation",
+                            "the plan's rotation is not the observed rotation");
+    if (mp_image_crop_valid(&p->params)) {
+        if (plan->source_crop_width == 0 ||
+            (int)plan->source_crop_x != p->params.crop.x0 ||
+            (int)plan->source_crop_y != p->params.crop.y0 ||
+            (int)plan->source_crop_width != mp_rect_w(p->params.crop) ||
+            (int)plan->source_crop_height != mp_rect_h(p->params.crop))
+            return admit_reject(reason, rn, "native.admission.source.crop",
+                                "the plan's crop is not the decoded frame's crop");
+    }
+    // An odd crop width or height is NOT refused here: the source's own
+    // dimensions are the decoder's fact and an odd 4:2:0 crop window is a
+    // mapping the producer must resolve (whole chroma pairs with an even tensor
+    // output), not a reason to foreclose the plan. The producer owns that
+    // decision and names any refusal it makes.
+    int num = 0, den = 0;
+    if (!status_rate_from_fps(p->fps, &num, &den) ||
+        (int)plan->source_fps_num != num || (int)plan->source_fps_den != den)
+        return admit_reject(reason, rn, "native.admission.source.fps",
+                            "the plan's cadence is not the observed source cadence");
+    const char *csp = mp_imgfmt_to_name(p->params.hw_subfmt);
+    if (!csp || strcmp(plan->source_csp, csp) != 0)
+        return admit_reject(reason, rn, "native.admission.source.csp",
+                            "the plan's pixel format is not the observed ingest format");
+    const int depth = p->params.repr.bits.sample_depth;
+    if (depth && (int)plan->source_bit_depth != depth)
+        return admit_reject(reason, rn, "native.admission.source.bitDepth",
+                            "the plan's bit depth is not the observed sample depth");
+
+    // Crop and rotation are the producer's: it applies the plan's crop and then
+    // its rotation to the coded frame it is fed, before any pre-resize, tensor
+    // or pad. This filter still feeds the coded frame and only asks that the
+    // plan's transform resolves to a geometry this build models.
+    int dw = 0, dh = 0;
+    if (!admit_display_size(plan, &dw, &dh))
+        return admit_reject(reason, rn, "native.admission.source.rotation",
+                            "the plan's rotation is not one of 0/90/180/270");
+
+    if (p->is_d3d11) {
+        if (strcmp(plan->backend, "directml") != 0)
+            return admit_reject(reason, rn, "native.admission.requested.backend",
+                                "the adopted device is DirectML, not TensorRT");
+        if (!p->adapter_luid[0] || strcmp(plan->adapter_luid, p->adapter_luid) != 0)
+            return admit_reject(reason, rn, "native.admission.device.adapterLuid",
+                                "the plan's adapter LUID is not the adopted device");
+    } else {
+        if (strcmp(plan->backend, "tensorrt") != 0)
+            return admit_reject(reason, rn, "native.admission.requested.backend",
+                                "the adopted device is TensorRT, not DirectML");
+        if (!p->compute_known || !p->compute_uuid[0] || !p->compute_uuid_hex[0])
+            return admit_reject(reason, rn, "native.admission.device.computeDeviceUuid",
+                                "the adopted compute device identity was not observed");
+        if (!p->decoder_uuid[0] || !plan->decoder_device_uuid[0])
+            return admit_reject(reason, rn, "native.admission.device.decoderDeviceUuid",
+                                "the plan states no decoder device identity");
+        if (strcmp(plan->decoder_device_uuid, p->decoder_uuid) != 0)
+            return admit_reject(reason, rn, "native.admission.device.decoderDeviceUuid",
+                                "the plan's decoder device is not the adopted device");
+        if (!admit_uuid_contains(plan->compute_device_uuid, p->compute_uuid_hex))
+            return admit_reject(reason, rn, "native.admission.device.computeDeviceUuid",
+                                "the plan's compute device is not the adopted compute device");
+        if ((int)plan->device_sm_major != p->sm_major ||
+            (int)plan->device_sm_minor != p->sm_minor)
+            return admit_reject(reason, rn, "native.admission.device.sm",
+                                "the plan's compute capability is not the adopted device's");
+        // The ABI names the adopted compute device in its own canonical form;
+        // the validated plan carries that observed value, not the caller's
+        // spelling of it.
+        snprintf(plan->compute_device_uuid, sizeof(plan->compute_device_uuid), "%s",
+                 p->compute_uuid_hex);
+        snprintf(plan->device_identity, sizeof(plan->device_identity), "%s",
+                 p->compute_uuid_hex);
+    }
+
+    const aji_native_prepared_stage_v1 *temporal = admit_temporal_stage(plan);
+    if (temporal && temporal->order == AJI_NATIVE_ORDER_BEFORE_SPATIAL &&
+        temporal->content_width != plan->source_coded_width && (!p->api.pre_resize ||
+        !p->api.resize))
+        return admit_reject(reason, rn, "native.admission.stage.preResize",
+                            "the plan needs a pre-RIFE downscale the loaded shim does not export");
+    return true;
+}
+
+// Adopt the producer's own facts after a whole-plan load. Nothing here invents
+// an output: the geometry comes from the producer's observation, and the Active
+// state still waits for a real emitted frame.
+static void admit_apply_plan_facts(struct mp_filter *vf, const aji_native_snapshot_v2 *snap)
+{
+    struct priv *p = vf->priv;
+    p->out_params = p->params;
+    p->out_params.w = snap->output_width ? (int)snap->output_width : p->params.w;
+    p->out_params.h = snap->output_height ? (int)snap->output_height : p->params.h;
+    // The shim applied the plan's crop and rotation to the frame it was fed, so
+    // the frames this filter emits are already oriented and uncropped: the
+    // output geometry is the whole frame, with no rotation left for the VO.
+    p->out_params.crop = (struct mp_rect){0, 0, p->out_params.w, p->out_params.h};
+    p->out_params.rotate = 0;
+    p->out_params.chroma_location = PL_CHROMA_LEFT;
+
+    p->out_fmt = p->aji_fmt;
+    if (p->opts->output_444 && !p->is_d3d11) {
+        p->out_fmt = AJI_FMT_YUV444P16;
+        p->out_params.hw_subfmt = pixfmt2imgfmt(AV_PIX_FMT_YUV444P16);
+        p->out_params.repr.bits = (struct pl_bit_encoding){
+            .sample_depth = 16, .color_depth = 16, .bit_shift = 0,
+        };
+    }
+
+    // RIFE order and factor come from the shim's own report of the loaded plan,
+    // the same source the conf-driven path reads, never from the descriptor.
+    p->rife_on = false;
+    p->rife_first = false;
+    p->has_pre_resize = false;
+    p->work_w = p->params.w;
+    p->work_h = p->params.h;
+    p->rife_num = p->rife_den = 1;
+    mp_image_unrefp(&p->rife_prev);
+    int rn = 0, rd = 0;
+    if (p->api.rife_factor(p->aji, &rn, &rd) && rd > 0 && rn > rd) {
+        int a = rn, b = rd;
+        while (b) {
+            int t = a % b;
+            a = b;
+            b = t;
+        }
+        rn /= a;
+        rd /= a;
+        if (rn <= 8 * rd) {
+            p->rife_num = rn;
+            p->rife_den = rd;
+            p->rife_on = true;
+        } else {
+            MP_WARN(vf, "Prepared RIFE factor %d/%d exceeds the supported 8x output "
+                        "multiplication\n", rn, rd);
+        }
+    }
+    p->rife_acc = p->rife_den;
+    p->rife_first = p->rife_on && p->api.rife_before_upscale &&
+                    p->api.rife_before_upscale(p->aji);
+    if (p->rife_first && p->api.pre_resize && p->api.resize) {
+        int ww = 0, wh = 0;
+        if (p->api.pre_resize(p->aji, &ww, &wh) && ww > 0 && wh > 0) {
+            p->has_pre_resize = true;
+            p->work_w = ww;
+            p->work_h = wh;
+        }
+    }
+    // RIFE-before-upscale interpolates at the display window the shim resolved
+    // (its own reported input geometry), not at the coded frame: the shim
+    // normalises the coded endpoints itself and the frames it writes there are
+    // what the upscale stages then accept.
+    if (p->rife_first && !p->has_pre_resize && snap->input_width && snap->input_height) {
+        p->work_w = (int)snap->input_width;
+        p->work_h = (int)snap->input_height;
+    }
+    p->aji_active = true;
+    p->cur_slot = p->pending_slot = (int)snap->effective_slot;
+    update_depth(vf);
+}
+
+static void admit_copy_snapshot(aji_native_snapshot_v2 *dst, const aji_native_snapshot_v2 *src)
+{
+    size_t n = src->struct_size;
+    if (n > sizeof(*src))
+        n = sizeof(*src);
+    if (n < sizeof(*dst))
+        memset((char *)dst + n, 0, sizeof(*dst) - n);
+    memcpy(dst, src, n);
+}
+
+// Drop the managed plan entirely: only a device/context generation change does
+// this, because the shim's engines live on the context that just went away.
+static void admit_forget(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->admit_stored && p->admit_phase == ADMIT_PHASE_NONE && !p->admit_effective)
+        return;
+    p->admit_stored = false;
+    p->admit_effective = false;
+    p->admit_phase = ADMIT_PHASE_NONE;
+    p->admit_refusal[0] = '\0';
+    p->admit_request_id[0] = '\0';
+    p->admit_recipe[0] = '\0';
+    p->admit_backend[0] = '\0';
+    p->admit_revision = 0;
+    p->admit_epoch = 0;
+    talloc_free(p->admit_plan);
+    p->admit_plan = NULL;
+    memset(&p->admit_snapshot, 0, sizeof(p->admit_snapshot));
+    // A worker result for the generation that just went away must be discarded.
+    p->admit_generation++;
+    status_touch(vf);
+}
+
+// While the worker exclusively owns the shim, the graph thread keeps frames
+// flowing untouched: it must never call into a context that is being
+// reconfigured. The original output geometry is restored when the job lands.
+static void admit_pause_inference(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    clear_ring(vf);
+    drain_backend(vf);
+    mp_image_unrefp(&p->rife_prev);
+    for (int i = 0; i < p->outq_n; i++)
+        mp_image_unrefp(&p->outq[p->outq_pos + i]);
+    p->outq_n = p->outq_pos = 0;
+    p->rife_acc = 1;
+    p->aji_active = false;
+    p->rife_on = false;
+    p->rife_first = false;
+    p->has_pre_resize = false;
+    p->work_w = p->params.w;
+    p->work_h = p->params.h;
+    p->out_params = p->params;
+    p->out_fmt = p->aji_fmt;
+    update_depth(vf);
+}
+
+// Restore the previously effective plan's own facts after a refusal, so a
+// refused replacement leaves the running chain exactly as it was.
+static void admit_restore_effective(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (p->admit_plan && p->aji)
+        admit_apply_plan_facts(vf, &p->admit_snapshot);
+}
+
+// The producer's answer to one job. A refused replacement keeps the previous
+// effective plan and its counters; a superseded generation is discarded whole.
+static void admit_finish_job(struct mp_filter *vf, struct admit_job *job)
+{
+    struct priv *p = vf->priv;
+    if (job->kind == ADMIT_JOB_APPLY || job->kind == ADMIT_JOB_CREATE) {
+        const aji_native_snapshot_v2 *snap = &job->snapshot;
+        bool loaded = job->rc == AJI_NATIVE_OK &&
+                      (snap->state == AJI_NATIVE_STATE_PREPARED ||
+                       snap->state == AJI_NATIVE_STATE_ACTIVE) &&
+                      (job->kind != ADMIT_JOB_CREATE || job->created != NULL);
+        if (!loaded) {
+            if (job->created) {
+                p->api.destroy(&job->created);
+                job->created = NULL;
+            }
+            p->admit_phase = ADMIT_PHASE_FAILED;
+            snprintf(p->admit_refusal, sizeof(p->admit_refusal),
+                     "the producer refused the plan: %s",
+                     snap->error[0] ? snap->error : "no prepared plan is reported");
+            MP_ERR(vf, "Managed admission refused: %s\n", p->admit_refusal);
+            admit_restore_effective(vf);
+            status_touch(vf);
+            return;
+        }
+        // The shim resolves the plan's source to its display geometry (crop,
+        // then rotation), so the stream geometry it validates is that one, and
+        // its output is the oriented chain output this filter then publishes.
+        int dw = 0, dh = 0;
+        if (!admit_display_size(&job->plan, &dw, &dh)) {
+            if (job->created) {
+                p->api.destroy(&job->created);
+                job->created = NULL;
+            }
+            p->admit_phase = ADMIT_PHASE_FAILED;
+            snprintf(p->admit_refusal, sizeof(p->admit_refusal),
+                     "the plan's rotation is not one this build models");
+            status_touch(vf);
+            return;
+        }
+        int ow = 0, oh = 0;
+        int cret = p->api.configure(job->created ? job->created : p->aji, dw, dh,
+                                    p->fps, &ow, &oh);
+        if (cret <= 0) {
+            const char *err = p->api.last_error(job->created ? job->created : p->aji);
+            if (job->created) {
+                p->api.destroy(&job->created);
+                job->created = NULL;
+            }
+            p->admit_phase = ADMIT_PHASE_FAILED;
+            snprintf(p->admit_refusal, sizeof(p->admit_refusal),
+                     "the prepared plan does not match the source geometry: %s",
+                     err && err[0] ? err : "no reason reported");
+            MP_ERR(vf, "%s\n", p->admit_refusal);
+            admit_restore_effective(vf);
+            status_touch(vf);
+            return;
+        }
+        if (job->kind == ADMIT_JOB_CREATE)
+            p->aji = job->created;
+        talloc_free(p->admit_plan);
+        p->admit_plan = talloc_zero(vf, aji_native_prepared_plan_v1);
+        MP_HANDLE_OOM(p->admit_plan);
+        *p->admit_plan = job->plan;
+        admit_copy_snapshot(&p->admit_snapshot, snap);
+        p->admit_effective = false;   // Active waits for a real emitted frame
+        p->admit_phase = ADMIT_PHASE_PREPARED;
+        p->admit_refusal[0] = '\0';
+        p->cadence_frames_in = 0;
+        p->cadence_frames_out = 0;
+        p->cadence_interpolated = 0;
+        p->cadence_scene_cuts = 0;
+        p->cadence_dropped = 0;
+        admit_apply_plan_facts(vf, snap);
+        MP_VERBOSE(vf, "Managed plan prepared: %u stages, output %ux%u\n",
+                   snap->stage_count, (unsigned)ow, (unsigned)oh);
+        status_touch(vf);
+        return;
+    }
