+#ifdef _WIN32
+// UTF-8 to UTF-16 for a path the loader is about to be given.
+//
+// mp_from_utf8() aborts the process on a byte sequence it cannot convert, which
+// is not an acceptable answer for a load that has to fail by name: the caller
+// asked for a module, and a malformed directory name must not end the player.
+// MB_ERR_INVALID_CHARS makes a lone surrogate or a truncated sequence fail here
+// instead of being silently replaced with U+FFFD, which would name a different
+// file than the caller asked for.
+static wchar_t *aji_widen_path(const char *path)
+{
+    if (!path || !path[0])
+        return NULL;
+    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);
+    if (n <= 0)
+        return NULL;
+    wchar_t *w = talloc_array(NULL, wchar_t, n);
+    if (!w)
+        return NULL;
+    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, w, n) <= 0) {
+        talloc_free(w);
+        return NULL;
+    }
+    return w;
+}
+#endif
