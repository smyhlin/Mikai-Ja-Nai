+// The observed cadence as a bounded exact rational. av_d2q recovers the
+// container's nominal rate instead of collapsing it onto a 1/1000 grid, so
+// 24000/1001 stays exact; both sides must fit the consumer's 1000000 bound.
+static bool status_rate_from_fps(double fps, int *num, int *den)
+{
+    if (!(fps > 0.0) || fps > 1000000.0)
+        return false;
+    AVRational rate = av_d2q(fps, 1000000);
+    if (rate.num < 1 || rate.den < 1 || rate.num > 1000000 || rate.den > 1000000)
+        return false;
+    *num = rate.num;
+    *den = rate.den;
+    return true;
+}
+
+// The state this build can prove. No shim loaded at all is the pure Probe
+// passthrough; a loaded shim is not a preparation report, so the legacy path is
+// never published as Prepared, Active or Ready.
+static const char *status_state_name(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    return p->api.handle ? "NeedsPreparation" : "Probe";
+}
+
+static const char *status_reason(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (p->api.handle)
+        return "the native engine is not prepared by this build";
+    if (!p->device_known)
+        return "probe passthrough: the decoder device identity is not available";
+    return "probe passthrough: no inference engine is configured";
+}
+
+// Build (or return the cached) snapshot document. Only re-serialises when a
+// published fact changed, so polling it does no per-request JSON construction.
+static const char *build_status_document(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->status_dirty && p->status_json)
+        return p->status_json;
+
+    talloc_free(p->status_json);
+    p->status_json = NULL;
+
+    const bool have_source = p->params.w > 0 && p->params.h > 0;
+    const bool have_device = p->device_known;
+
+    bstr s = {0};
+    bstr_xappend_asprintf(vf, &s,
+        "{\"schema\":\"mikai.native.status/1\",\"protocol\":1,"
+        "\"revision\":%lld,\"state\":\"%s\",\"epoch\":%lld",
+        (long long)p->status_revision, status_state_name(vf),
+        (long long)p->status_epoch);
+
+    if (have_source || have_device) {
+        bstr_xappend0(vf, &s, ",\"probe\":{");
+        if (have_source) {
+            bstr_xappend_asprintf(vf, &s, "\"source\":{\"codedW\":%d,\"codedH\":%d",
+                                  p->params.w, p->params.h);
+            // An adopted frame reports rotate == 0 when it carries none, so
+            // zero is an observed fact; only an angle this build does not
+            // model stays absent (the consumer refuses it by name).
+            const int rotate = p->params.rotate;
+            if (rotate == 0 || rotate == 90 || rotate == 180 || rotate == 270)
+                bstr_xappend_asprintf(vf, &s, ",\"rotation\":%d", rotate);
+            // The decoder's own crop rect, in coded coordinates; a frame with
+            // no valid rect has no crop to report.
+            if (mp_image_crop_valid(&p->params))
+                bstr_xappend_asprintf(vf, &s,
+                    ",\"crop\":{\"x\":%d,\"y\":%d,\"w\":%d,\"h\":%d}",
+                    p->params.crop.x0, p->params.crop.y0,
+                    mp_rect_w(p->params.crop), mp_rect_h(p->params.crop));
+            int num = 0, den = 0;
+            if (status_rate_from_fps(p->fps, &num, &den))
+                bstr_xappend_asprintf(vf, &s, ",\"fps\":{\"num\":%d,\"den\":%d}",
+                                      num, den);
+            const char *csp = mp_imgfmt_to_name(p->params.hw_subfmt);
+            if (csp && csp[0])
+                bstr_xappend_asprintf(vf, &s, ",\"csp\":\"%s\"", csp);
+            // Colour facts exactly as libmpv names them, and only when the
+            // adopted params carry one: "auto"/"unknown" is not a fact.
+            const char *matrix = NULL;
+            if (p->params.repr.sys != PL_COLOR_SYSTEM_UNKNOWN)
+                matrix = m_opt_choice_str(pl_csp_names, p->params.repr.sys);
+            if (matrix && matrix[0])
+                bstr_xappend_asprintf(vf, &s, ",\"matrix\":\"%s\"", matrix);
+            const char *range = NULL;
+            if (p->params.repr.levels != PL_COLOR_LEVELS_UNKNOWN)
+                range = m_opt_choice_str(pl_csp_levels_names, p->params.repr.levels);
+            if (range && range[0])
+                bstr_xappend_asprintf(vf, &s, ",\"range\":\"%s\"", range);
+            const char *siting = NULL;
+            if (p->params.chroma_location != PL_CHROMA_UNKNOWN)
+                siting = m_opt_choice_str(pl_chroma_names, p->params.chroma_location);
+            if (siting && siting[0])
+                bstr_xappend_asprintf(vf, &s, ",\"siting\":\"%s\"", siting);
+            const int depth = p->params.repr.bits.sample_depth;
+            if (depth == 8 || depth == 10 || depth == 12 || depth == 16)
+                bstr_xappend_asprintf(vf, &s, ",\"bitDepth\":%d", depth);
+            bstr_xappend0(vf, &s, "}");
+        }
+        if (have_device) {
+            bstr_xappend0(vf, &s, have_source ? ",\"device\":{" : "\"device\":{");
+            bool first = true;
+            if (p->decoder_uuid[0]) {
+                bstr_xappend_asprintf(vf, &s, "%s\"decoderDeviceUuid\":\"%s\"",
+                                      first ? "" : ",", p->decoder_uuid);
+                first = false;
+            }
+            if (p->adapter_luid[0]) {
+                bstr_xappend_asprintf(vf, &s, "%s\"adapterLuid\":\"%s\"",
+                                      first ? "" : ",", p->adapter_luid);
+                first = false;
+            }
+            if (p->sm_major > 0) {
+                bstr_xappend_asprintf(vf, &s, "%s\"smMajor\":%d,\"smMinor\":%d",
+                                      first ? "" : ",", p->sm_major, p->sm_minor);
+                first = false;
+            }
+            bstr_xappend0(vf, &s, "}");
+        }
+        bstr_xappend0(vf, &s, "}");
+    }
+
+    bstr_xappend_asprintf(vf, &s, ",\"reason\":\"%s\"}", status_reason(vf));
+
+    p->status_json = s.start;
+    p->status_dirty = false;
+    return p->status_json;
+}
