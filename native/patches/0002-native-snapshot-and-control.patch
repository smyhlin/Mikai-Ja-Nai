+extern "C" AJI_EXPORT int aji_native_backend_snapshot(
+    aji_ctx *c, aji_native_snapshot_v2 *s)
+{
+    if (!c || !s) return AJI_NATIVE_INVALID_ARGUMENT;
+    s->backend = 2;
+    snprintf(s->provider, sizeof(s->provider), "%s", "DirectML");
+    s->capability_bits = AJI_NATIVE_CAP_TICKET_DRAIN;
+    if ((c->active || c->native_suspended) &&
+        c->native_saved_w >= 2 && c->native_saved_h >= 2)
+        s->capability_bits |= AJI_NATIVE_CAP_SUSPEND_RESUME;
+    
+
+
+    s->last_submitted_ticket = c->done_val;
+    s->completed_ticket = (c->done_fence ? c->done_fence->GetCompletedValue() : 0);
+    s->requested_slot = c->native_requested_slot;
+    s->revision = c->native_revision;
+    s->epoch = c->native_epoch;
+
+    s->effective_slot = 0;
+    s->input_width = c->in_w; s->input_height = c->in_h;
+
+    s->output_width = 0; s->output_height = 0;
+    s->stage_count = (uint32_t)c->models.size() + (c->rife.enabled ? 1u : 0u);
+    uint32_t index = 0;
+    for (const auto &model : c->models) {
+        if (index >= AJI_NATIVE_MAX_STAGES) break;
+        snprintf(s->model_sha256[index++], AJI_NATIVE_SHA256_CAPACITY, "%s", model.model_sha256.c_str());
+    }
+    if (c->rife.enabled && index < AJI_NATIVE_MAX_STAGES)
+        snprintf(s->model_sha256[index++], AJI_NATIVE_SHA256_CAPACITY, "%s", c->rife.model.model_sha256.c_str());
+
+    snprintf(s->requested_plan, sizeof(s->requested_plan), "slot:%u", c->native_requested_slot);
+    s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+    ComPtr<IDXGIDevice> dxgi; ComPtr<IDXGIAdapter> adapter; DXGI_ADAPTER_DESC desc = {};
+    if (SUCCEEDED(c->dev11.As(&dxgi)) && SUCCEEDED(dxgi->GetAdapter(&adapter)) && SUCCEEDED(adapter->GetDesc(&desc))) {
+        snprintf(s->device_identity, sizeof(s->device_identity), "D3D11-LUID:%08X%08X", (uint32_t)desc.AdapterLuid.HighPart, (uint32_t)desc.AdapterLuid.LowPart);
+        s->capability_bits |= AJI_NATIVE_CAP_D3D_ADAPTER_LUID;
+    }
+    snprintf(s->error, sizeof(s->error), "%s",
+             "prepared-plan identity is not independently verified by this producer");
+    return AJI_NATIVE_OK;
+}
+
+extern "C" AJI_EXPORT int aji_native_backend_control(
+    aji_ctx *c, uint32_t action, uint64_t epoch, uint32_t timeout_ms)
+{
+    if (!c) return AJI_NATIVE_INVALID_ARGUMENT;
+    if (action == AJI_NATIVE_CONTROL_RESUME) {
+        if (!c->native_suspended) return AJI_NATIVE_OPERATION_FAILED;
+        c->slot = (int)c->native_saved_slot;
+        c->native_suspended = false;
+        int out_w = 0, out_h = 0;
+        const int configured = aji_configure(c, c->native_saved_w, c->native_saved_h, c->native_saved_fps, &out_w, &out_h);
+        if (configured <= 0) { c->native_suspended = true; c->set_error("resume found no usable prepared plan"); return AJI_NATIVE_OPERATION_FAILED; }
+        c->native_epoch = epoch; ++c->native_revision; return AJI_NATIVE_OK;
+    }
+    const uint64_t ticket = aji_flush(c, nullptr);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+    while (ticket) {
+        const int done = aji_done(c, ticket);
+        if (done == 1) break;
+        if (done < 0) return AJI_NATIVE_OPERATION_FAILED;
+        if (std::chrono::steady_clock::now() >= deadline) { c->set_error("native drain timed out at ticket %llu", (unsigned long long)ticket); return AJI_NATIVE_OPERATION_FAILED; }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    if (action == AJI_NATIVE_CONTROL_SUSPEND) {
+        if (!c->active || c->native_saved_w < 2 || c->native_saved_h < 2) {
+            c->set_error("suspend requires a configured plan");
+            return AJI_NATIVE_OPERATION_FAILED;
+        }
+        c->native_saved_slot = (uint32_t)c->slot; c->slot = 0;
+        int out_w = 0, out_h = 0;
+        const int configured = aji_configure(c, c->native_saved_w, c->native_saved_h, c->native_saved_fps, &out_w, &out_h);
+        if (configured < 0) { c->slot = (int)c->native_saved_slot; return AJI_NATIVE_OPERATION_FAILED; }
+        chain_teardown(c);
+        c->active = false;
+        c->native_suspended = true;
+        ++c->native_revision;
+        return AJI_NATIVE_OK;
+    }
+    return AJI_NATIVE_OK;
+}
