+extern "C" AJI_EXPORT int aji_native_backend_snapshot(
+    aji_ctx *c, aji_native_snapshot_v2 *s)
+{
+    if (!c || !s) return AJI_NATIVE_INVALID_ARGUMENT;
+    s->backend = 1;
+    snprintf(s->provider, sizeof(s->provider), "%s", "TensorRT");
+    s->capability_bits = AJI_NATIVE_CAP_TICKET_DRAIN;
+    if (c->conf_mode && (c->active || c->native_suspended) &&
+        c->native_saved_w >= 2 && c->native_saved_h >= 2)
+        s->capability_bits |= AJI_NATIVE_CAP_SUSPEND_RESUME;
+
+    s->last_submitted_ticket = c->tick_next - 1;
+    s->completed_ticket = c->tick_completed;
+    s->requested_slot = c->native_requested_slot;
+    s->revision = c->native_revision;
+    s->epoch = c->native_epoch;
+
+    s->effective_slot = 0;
+    s->input_width = c->in_w; s->input_height = c->in_h;
+
+    s->output_width = 0; s->output_height = 0;
+    s->stage_count = (uint32_t)c->engines.size() + (c->rife.enabled ? 1u : 0u) + (!c->conf_mode && c->direct.engine ? 1u : 0u);
+    uint32_t index = 0;
+    for (const auto &engine : c->engines) {
+        if (index >= AJI_NATIVE_MAX_STAGES) break;
+        snprintf(s->engine_sha256[index], AJI_NATIVE_SHA256_CAPACITY, "%s", engine.engine_sha256.c_str());
+        snprintf(s->model_sha256[index], AJI_NATIVE_SHA256_CAPACITY, "%s", engine.model_sha256.c_str());
+        ++index;
+    }
+    if (c->rife.enabled && index < AJI_NATIVE_MAX_STAGES) {
+        snprintf(s->engine_sha256[index], AJI_NATIVE_SHA256_CAPACITY, "%s", c->rife.engine.engine_sha256.c_str());
+        snprintf(s->model_sha256[index], AJI_NATIVE_SHA256_CAPACITY, "%s", c->rife.engine.model_sha256.c_str());
+        ++index;
+    }
+    s->state = AJI_NATIVE_STATE_UNAVAILABLE;
+    if (!c->conf_mode && c->direct.engine && index < AJI_NATIVE_MAX_STAGES)
+        snprintf(s->engine_sha256[index], AJI_NATIVE_SHA256_CAPACITY, "%s", c->direct.engine_sha256.c_str());
+
+    snprintf(s->requested_plan, sizeof(s->requested_plan), "slot:%u", c->native_requested_slot);
+    CtxGuard guard(c->cu_ctx);
+    CUdevice device; CUuuid uuid;
+    if (guard.ok && cuCtxGetDevice(&device) == CUDA_SUCCESS && cuDeviceGetUuid(&uuid, device) == CUDA_SUCCESS) {
+        int pos = snprintf(s->device_identity, sizeof(s->device_identity), "CUDA-UUID:");
+        for (int i = 0; i < 16 && pos < (int)sizeof(s->device_identity) - 2; ++i) pos += snprintf(s->device_identity + pos, sizeof(s->device_identity) - pos, "%02x", (unsigned char)uuid.bytes[i]);
+        s->capability_bits |= AJI_NATIVE_CAP_CU_DEVICE_UUID;
+    }
+    snprintf(s->error, sizeof(s->error), "%s",
+             "prepared-plan identity is not independently verified by this producer");
+    return AJI_NATIVE_OK;
+}
