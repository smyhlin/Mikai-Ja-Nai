+static void reset_native_refusal(aji_native_snapshot_v2 *snapshot,
+                                 uint32_t requested_protocol, uint32_t result)
+{
+    char error[AJI_NATIVE_TEXT_CAPACITY];
+    snprintf(error, sizeof(error), "%s", snapshot->error);
+    const uint32_t size = snapshot->struct_size;
+    memset(snapshot, 0, sizeof(*snapshot));
+    snapshot->struct_size = size;
+    snapshot->requested_protocol_version = requested_protocol;
+    snapshot->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    snapshot->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    snapshot->aji_abi_version = AJI_API_VERSION;
+    snapshot->result = result;
+    snapshot->state = AJI_NATIVE_STATE_UNAVAILABLE;
+    snprintf(snapshot->error, sizeof(snapshot->error), "%s", error);
+}
+
+extern "C" AJI_EXPORT int aji_native_get_snapshot(
+    aji_ctx *c, uint32_t requested_protocol, aji_native_snapshot_v2 *s)
+{
+    if (!s || s->struct_size != sizeof(*s))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    const uint32_t size = s->struct_size;
+    memset(s, 0, sizeof(*s));
+    s->struct_size = size;
+    s->requested_protocol_version = requested_protocol;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+
+
+    if (requested_protocol != AJI_NATIVE_PROTOCOL_VERSION) {
+        snprintf(s->error, sizeof(s->error), "protocol mismatch: caller=%u producer=%u",
+                 requested_protocol, AJI_NATIVE_PROTOCOL_VERSION);
+        s->result = AJI_NATIVE_PROTOCOL_MISMATCH;
+        return AJI_NATIVE_PROTOCOL_MISMATCH;
+    }
+    if (!c) {
+        snprintf(s->error, sizeof(s->error), "native context is absent");
+        s->result = AJI_NATIVE_NO_CONTEXT;
+        return AJI_NATIVE_NO_CONTEXT;
+    }
+    const int rc = c->be.native_snapshot(c->inner, s);
+    if (rc != AJI_NATIVE_OK) {
+        reset_native_refusal(s, requested_protocol, AJI_NATIVE_BACKEND_UNAVAILABLE);
+        return AJI_NATIVE_BACKEND_UNAVAILABLE;
+    }
+    s->struct_size = size;
+    s->requested_protocol_version = requested_protocol;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+    s->result = AJI_NATIVE_OK;
+    return AJI_NATIVE_OK;
+}
+
+extern "C" AJI_EXPORT int aji_native_control(
+    aji_ctx *c, uint32_t requested_protocol, uint32_t action, uint64_t epoch,
+    uint32_t timeout_ms, aji_native_snapshot_v2 *s)
+{
+    if (!s || s->struct_size != sizeof(*s))
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    const uint32_t size = s->struct_size;
+    memset(s, 0, sizeof(*s));
+    s->struct_size = size;
+    s->requested_protocol_version = requested_protocol;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+
+
+    if (requested_protocol != AJI_NATIVE_PROTOCOL_VERSION) {
+        snprintf(s->error, sizeof(s->error), "protocol mismatch: caller=%u producer=%u",
+                 requested_protocol, AJI_NATIVE_PROTOCOL_VERSION);
+        s->result = AJI_NATIVE_PROTOCOL_MISMATCH;
+        return AJI_NATIVE_PROTOCOL_MISMATCH;
+    }
+    if (action < AJI_NATIVE_CONTROL_DRAIN || action > AJI_NATIVE_CONTROL_RESUME) {
+        snprintf(s->error, sizeof(s->error), "unknown native control action: %u", action);
+        s->result = AJI_NATIVE_INVALID_ARGUMENT;
+        return AJI_NATIVE_INVALID_ARGUMENT;
+    }
+    if (!c) {
+        snprintf(s->error, sizeof(s->error), "native context is absent");
+        s->result = AJI_NATIVE_NO_CONTEXT;
+        return AJI_NATIVE_NO_CONTEXT;
+    }
+    int rc = c->be.native_control(c->inner, action, epoch, timeout_ms);
+    const int snapshot_rc = c->be.native_snapshot(c->inner, s);
+    if (rc == AJI_NATIVE_OK && snapshot_rc != AJI_NATIVE_OK)
+        rc = snapshot_rc;
+    if (rc != AJI_NATIVE_OK) {
+        reset_native_refusal(s, requested_protocol, AJI_NATIVE_OPERATION_FAILED);
+        return AJI_NATIVE_OPERATION_FAILED;
+    }
+    s->struct_size = size;
+    s->requested_protocol_version = requested_protocol;
+    s->protocol_version = AJI_NATIVE_PROTOCOL_VERSION;
+    s->schema_version = AJI_NATIVE_SCHEMA_VERSION;
+    s->aji_abi_version = AJI_API_VERSION;
+    s->result = AJI_NATIVE_OK;
+    return AJI_NATIVE_OK;
+}
