# Local secrets and machine-specific configuration
.env*
/.mcp.json

# Build and release output
/build/
/build-*/
cmake-build-*/
dist/
/dist-*/
/dist-mikai/
/release-artifacts/
/ci-artifacts/
/collected/

# Runtime stores and acquired/generated model data (not application source)
/native/components/
/native/assets/
/native/animejanai/
/native/models/
/native/cache/
/native/caches/
/native/user-data/
/native/user-store/
/native/user-stores/
/native/userdata/
/native/logs/
/native/crashes/
/native/crash-dumps/
/models/
/user-data/
/user-store/
/user-stores/
/userdata/
/cache/
/caches/
/logs/
/crashes/
/crash-dumps/

# Local scratch and diagnostic output
_scratch_*.py
_scratch_*.json
_*.png
/runtime_recovery_*.png
_ui_geometry.json
_grab_*.png
*.log
*.log.*
*.dmp
*.core
/core
/probe-out/
/.probe-out/
/.probe-*
/omp/
/.omp/
/$env
/LauncherContracts/
/mikai-tests-*/
test-results/
Testing/

# Archives and platform build products must not enter source accidentally
*.zip
*.7z
*.tar
*.tar.gz
*.tar.xz
*.tar.zst
*.exe
*.dll
*.so
*.dylib

# Generated translation binaries: the .ts is the source, lrelease produces the .qm
translations/*.qm

/tests/fixtures/media/hdr_*.mp4
/tests/fixtures/media/motion_frame_id_*.mp4
/tests/fixtures/media/continuous_frame_id_*.mp4

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
# Keep intentional public image assets trackable.
# (No blanket image or assets-directory exclusion.)

# AppImage extraction leftovers must never be committed
/squashfs-root/
/AppDir/
