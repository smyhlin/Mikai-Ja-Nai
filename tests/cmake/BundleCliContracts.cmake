if(NOT DEFINED BUNDLE_TOOL OR NOT EXISTS "${BUNDLE_TOOL}")
  message(FATAL_ERROR "BUNDLE_TOOL must name the built mikai_bundle executable")
endif()
if(NOT DEFINED MPV_MODULE OR NOT EXISTS "${MPV_MODULE}")
  message(FATAL_ERROR "MPV_MODULE must name the selected stock libmpv")
endif()

string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef work_id)
set(work "${CMAKE_CURRENT_BINARY_DIR}/bundle-cli-contracts-${work_id}")
if(EXISTS "${work}")
  message(FATAL_ERROR "refusing to use pre-existing bundle contract work directory: ${work}")
endif()
file(MAKE_DIRECTORY "${work}/standard/mpv")
file(REAL_PATH "${CMAKE_CURRENT_BINARY_DIR}" binary_root_real)
file(REAL_PATH "${work}" work_real)
cmake_path(IS_PREFIX binary_root_real "${work_real}" NORMALIZE work_is_beneath_build)
if(NOT work_is_beneath_build)
  file(REMOVE_RECURSE "${work}")
  message(FATAL_ERROR "bundle contract work directory escaped the build root: ${work_real}")
endif()
set(root "${work}/standard")
get_filename_component(module_name "${MPV_MODULE}" NAME)
if(DEFINED MPV_RUNTIME_DIR AND NOT MPV_RUNTIME_DIR STREQUAL "")
  file(GLOB_RECURSE runtime_libraries LIST_DIRECTORIES FALSE "${MPV_RUNTIME_DIR}/*.so*")
else()
  set(runtime_libraries "")
endif()
list(APPEND runtime_libraries "${MPV_MODULE}")
list(REMOVE_DUPLICATES runtime_libraries)
if(NOT WIN32)
  set(unique_mpv_libraries "")
  foreach(library IN LISTS runtime_libraries)
    get_filename_component(candidate_name "${library}" NAME)
    if(candidate_name MATCHES "^libmpv" AND NOT candidate_name STREQUAL module_name)
      continue()
    endif()
    list(APPEND unique_mpv_libraries "${library}")
  endforeach()
  set(runtime_libraries "${unique_mpv_libraries}")
endif()
set(file_records "")
foreach(library IN LISTS runtime_libraries)
  get_filename_component(name "${library}" NAME)
  file(COPY_FILE "${library}" "${root}/mpv/${name}" ONLY_IF_DIFFERENT)
  file(SHA256 "${root}/mpv/${name}" digest)
  file(SIZE "${root}/mpv/${name}" bytes)
  if(file_records)
    string(APPEND file_records ",\n")
  endif()
  string(APPEND file_records "    {\"path\": \"mpv/${name}\", \"bytes\": ${bytes}, \"sha256\": \"${digest}\"}")
endforeach()

set(manifest "{\n  \"schema\": \"mikai.native.bundle/1\",\n  \"kind\": \"standard\",\n  \"version\": \"1.0.0\",\n  \"module\": \"mpv/${module_name}\",\n  \"mpvApiVersion\": 0,\n  \"protocolVersion\": 0,\n  \"engineSchemaVersion\": 0,\n  \"deps\": [\"mpv\"],\n  \"files\": [\n${file_records}\n  ]\n}\n")
file(WRITE "${root}/bundle.json" "${manifest}")
execute_process(COMMAND "${BUNDLE_TOOL}" verify "${root}"
  RESULT_VARIABLE verify_rc OUTPUT_VARIABLE verify_out ERROR_VARIABLE verify_err
  TIMEOUT 90)
if(NOT verify_rc EQUAL 0)
  message(FATAL_ERROR "real Standard bundle verification failed (${verify_rc})\nstdout:\n${verify_out}\nstderr:\n${verify_err}")
endif()
if(NOT verify_out MATCHES "accepted:")
  message(FATAL_ERROR "verify did not report acceptance of the assembled Standard bundle\n${verify_out}")
endif()

# Exercise the real Native protocol gate without pretending a stock core has the
# private filter or producer ABI. The same exact payload is labelled Native with
# an unsupported protocol and must be refused before any native capability test.
set(native_root "${work}/unsupported-native")
file(MAKE_DIRECTORY "${native_root}")
file(COPY "${root}/mpv" DESTINATION "${native_root}")
string(REPLACE "\"kind\": \"standard\"" "\"kind\": \"native\"" native_manifest "${manifest}")
string(REPLACE "\"protocolVersion\": 0" "\"protocolVersion\": 999" native_manifest "${native_manifest}")
file(WRITE "${native_root}/bundle.json" "${native_manifest}")
execute_process(COMMAND "${BUNDLE_TOOL}" verify "${native_root}"
  RESULT_VARIABLE native_rc OUTPUT_VARIABLE native_out ERROR_VARIABLE native_err
  TIMEOUT 30)
if(native_rc EQUAL 0)
  message(FATAL_ERROR "unsupported Native bundle was accepted\n${native_out}\n${native_err}")
endif()
if(native_out MATCHES "core accepts @mikai_native")
  message(FATAL_ERROR "unsupported Native bundle reached native-capability success reporting\n${native_out}")
endif()
